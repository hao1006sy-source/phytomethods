    "check": "astro check",
    "check:platform-data": "node scripts/check-platform-data.mjs",
    "test:platform-browser": "node scripts/browser-test-platform-v1.mjs",
    "check:topic-markdown": "node scripts/check-topic-markdown-rendering.mjs",
    "check:scientific-taxonomy": "node scripts/check-scientific-taxonomy.mjs",
    "validate": "npm run build && node scripts/check-home-curation.mjs && node scripts/check-domain-v2.mjs && python scripts/check-links.py && npm run audit:knowledge && npm run test:knowledge-integrity && npm run test:application-evidence && npm run test:msmc-chronology && npm run test:independent-evidence && npm run check:topic-markdown && npm run check:platform-data && npm run check:genome-hub && npm run check:scientific-taxonomy",
    "coverage": "node scripts/content-coverage.mjs",
    "audit:knowledge": "node scripts/audit-knowledge-relations.mjs",
    "test:knowledge-integrity": "node scripts/test-knowledge-integrity.mjs",
    "test:application-evidence": "node scripts/test-application-method-evidence.mjs",
    "test:msmc-chronology": "node scripts/test-msmc-chronology.mjs",
    "test:independent-evidence": "node scripts/test-independent-evidence-review.mjs",
    "test:knowledge": "node scripts/browser-test-knowledge-relations.mjs",
    "test:knowledge-v2": "node scripts/browser-test-knowledge-v2.mjs",
    "test:topic-markdown": "node scripts/browser-test-topic-markdown-rendering.mjs",
    "test:papers-v3": "node scripts/browser-test-paper-v3-full-rollout.mjs",
    "test:figure-a11y": "node scripts/browser-test-figure-a11y.mjs",
    "test:methods-v3": "node scripts/browser-test-method-v3-full-rollout.mjs",
    "test:methods-index-v4": "node scripts/browser-test-methods-index-v4.mjs",
    "check:tutorial-science": "node scripts/check-tutorial-scientific-quality.mjs",
    "check:cafe5": "node scripts/check-cafe5-reproducibility.mjs",
    "check:genome-hub": "node scripts/check-genome-hub-data.mjs",
    "test:genome-hub": "node scripts/browser-test-genome-hub.mjs",
    "test:search-v2": "node scripts/browser-test-search-v2.mjs"
