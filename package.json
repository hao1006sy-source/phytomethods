  "dependencies": {
    "@astrojs/markdown-remark": "^7.3.10",
    "@astrojs/mdx": "^8.1.6",
    "@astrojs/sitemap": "^3.7.6",
    "astro": "^7.4.13",
    "katex": "^0.19.1",
    "mermaid": "^12.3.0",
    "pagefind": "^1.3.0",
    "rehype-katex": "^7.0.1",
    "remark-math": "^6.0.0"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.0",
    "playwright": "^1.65.1",
    "playwright-core": "^1.65.1",
    "typescript": "^5.0.0"
  },
