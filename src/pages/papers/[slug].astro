---
import Base from '../../layouts/Base.astro';
import DraftPreview from '../../components/DraftPreview.astro';
import PaperPageLayout from '../../components/paper-v3/PaperPageLayout.astro';
import { getCollection, render } from 'astro:content';

export async function getStaticPaths() {
  return (await getCollection('papers', ({ data }) => data.status === 'published' || import.meta.env.DEV)).map(entry => ({
    params: { slug: entry.id },
    props: { entry }
  }));
}

const { entry } = Astro.props;
const { Content, headings } = await render(entry);

const allMethods = await getCollection('methods', ({ data }) => data.status === 'published' || import.meta.env.DEV);
const allPapers = await getCollection('papers', ({ data }) => data.status === 'published' || import.meta.env.DEV);
const allTutorials = await getCollection('tutorials', ({ data }) => data.status === 'published' || import.meta.env.DEV);
---

<Base title={entry.data.title} description={entry.data.summary}>
  <DraftPreview status={entry.data.status} />
  <PaperPageLayout
    entry={entry}
    headings={headings}
    allMethods={allMethods}
    allPapers={allPapers}
    allTutorials={allTutorials}
  >
    <Content />
  </PaperPageLayout>
</Base>
