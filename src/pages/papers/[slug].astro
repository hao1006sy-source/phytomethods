---
import Base from '../../layouts/Base.astro';import DraftPreview from '../../components/DraftPreview.astro';import {topicMetadata} from '../../data/topics';import {getCollection,render} from 'astro:content';
export async function getStaticPaths(){return (await getCollection('papers',({data})=>data.status==='published'||import.meta.env.DEV)).map(entry=>({params:{slug:entry.id},props:{entry}}));}const {entry}=Astro.props;const {Content}=await render(entry);const base=import.meta.env.BASE_URL;
---
<Base title={entry.data.title}><DraftPreview status={entry.data.status}/><p><a href={`${base}papers/`}>文献索引</a></p><h1>{entry.data.title}</h1><p>{entry.data.authors} · {entry.data.journal} · {entry.data.year}</p><p>{entry.data.type==='method'?'方法论文':'研究案例'} · <a href={`https://doi.org/${entry.data.doi}`}>DOI: {entry.data.doi}</a></p><Content/>{entry.data.methodIds.length>0 && <p>相关方法：{entry.data.methodIds.map(id=><a href={`${base}methods/${id}/`}>{id}　</a>)}</p>}<h2>相关专题</h2><ul>{topicMetadata.filter(t=>(t.status==='published'||import.meta.env.DEV)&&t.paperIds.includes(entry.id)).map(t=><li><a href={`${base}topics/${t.domainId}/${t.id}/`}>{t.title}</a></li>)}</ul></Base>
