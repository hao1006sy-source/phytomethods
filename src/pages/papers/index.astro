---
import Base from '../../layouts/Base.astro';import {getCollection} from 'astro:content';import {domains} from '../../data/domains';import {speciesLabels,paperTypeLabels} from '../../data/tags';
const entries=await getCollection('papers',({data})=>data.status==='published');const methods=await getCollection('methods',({data})=>data.status==='published');const years=[...new Set(entries.map(e=>e.data.year))].sort((a,b)=>b-a);const base=import.meta.env.BASE_URL;
---
<Base title="文献索引"><h1>文献索引</h1><form id="filters" class="filters"><label>关键词 <input id="filter" name="q" type="search" placeholder="标题或作者"/></label><label>年份 <select name="year"><option value="">全部</option>{years.map(y=><option value={y}>{y}</option>)}</select></label><label>文献类型 <select name="type"><option value="">全部</option>{Object.entries(paperTypeLabels).map(([id,label])=><option value={id}>{label}</option>)}</select></label><label>领域 <select name="domain"><option value="">全部</option>{domains.map(d=><option value={d[1]}>{d[2]}</option>)}</select></label><label>相关工具 <select name="method"><option value="">全部</option>{methods.map(m=><option value={m.id}>{m.data.name}</option>)}</select></label><label>物种 <select name="species"><option value="">全部</option>{Object.entries(speciesLabels).map(([id,label])=><option value={id}>{label}</option>)}</select></label><button type="reset">重置筛选</button></form><p id="filter-count" aria-live="polite"></p><div class="list-view">{entries.map(e=><article class="card filter-item" data-q={`${e.data.title} ${e.data.authors} ${e.data.doi}`} data-year={e.data.year} data-type={e.data.type} data-domain={e.data.domainIds.join('|')} data-method={e.data.methodIds.join('|')} data-species={e.data.speciesIds.join('|')}><h2><a href={`${base}papers/${e.id}/`}>{e.data.title}</a></h2><p>{e.data.authors} · {e.data.journal} · {e.data.year}</p><p>{paperTypeLabels[e.data.type]}</p></article>)}</div><script src="../../scripts/filters.ts"></script></Base>
