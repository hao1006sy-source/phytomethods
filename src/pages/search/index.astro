---
import Base from '../../layouts/Base.astro';const base=import.meta.env.BASE_URL;
---
<Base title="全站搜索"><section class="nav-v3"><p class="nav-overline">SITE SEARCH</p><h1>全站搜索</h1><p class="page-lead">在研究领域、专题、方法工具、文献和分析教程之间快速定位科研知识。</p><section class="nav-search-hero"><div class="search-entry"><div id="search"></div><button id="search-submit" type="button">搜索</button></div><div class="search-suggestions">热门检索 {['Hifiasm','GWAS','泛基因组','单细胞分析','WGCNA'].map(q=><a href={`${base}search/?q=${encodeURIComponent(q)}`}>{q}</a>)}</div></section><section id="search-guide"><h2 class="nav-section-title">或者按资源类型浏览</h2><div class="search-shortcuts">{[['topics/','研究领域','沿九大研究方向浏览专题与方法'],['methods/','算法与工具','查找工具原理、输入数据与应用'],['papers/','文献与教程','追溯原始论文，查看分析流程']].map(([href,title,desc])=><a href={`${base}${href}`}><h2>{title}</h2><p>{desc}</p><span>浏览全部 →</span></a>)}</div><p class="search-help">搜索提示：支持中文学术概念、英文工具名称、作者和 DOI；输入后展示全文检索结果。</p></section></section><link href={`${base}pagefind-search/pagefind-ui.css`} rel="stylesheet"/><script is:inline define:vars={{base}}>
const s=document.createElement('script');s.src=base+'pagefind-search/pagefind-ui.js';s.onload=()=>{new PagefindUI({element:'#search',showSubResults:true,translations:{placeholder:'搜索方法、专题或文献',zero_results:'未找到结果'}});const inputEl=document.querySelector('.pagefind-ui__search-input');inputEl?.addEventListener('input',()=>{const value=inputEl.value.trim();document.getElementById('search-guide').hidden=!!value;const url=new URL(location.href);if(value)url.searchParams.set('q',value);else url.searchParams.delete('q');history.replaceState(null,'',url);});document.getElementById('search-submit').addEventListener('click',()=>{inputEl?.focus();inputEl?.dispatchEvent(new Event('input',{bubbles:true}));});const q=new URLSearchParams(location.search).get('q');if(q){const input=document.querySelector('.pagefind-ui__search-input');input.value=q;input.dispatchEvent(new Event('input',{bubbles:true}));}};document.body.appendChild(s);
</script></Base>
