---
import fs from 'node:fs';
import path from 'node:path';
import Base from '../../layouts/Base.astro';
import KnowledgeHeader from '../../components/knowledge-v2/KnowledgeHeader.astro';
import KnowledgeFilterPanel from '../../components/knowledge-v2/KnowledgeFilterPanel.astro';
import KnowledgeCanvas from '../../components/knowledge-v2/KnowledgeCanvas.astro';
import KnowledgeInspector from '../../components/knowledge-v2/KnowledgeInspector.astro';
import type { KnowledgeGraphV2 } from '../../lib/knowledge/graph-types';
import '../../components/knowledge-v2/knowledge-v2.css';

// 读取真实治理的知识图谱数据
const graphFilePath = path.resolve(process.cwd(), 'outputs/knowledge-graph-v2.json');
let graphData: KnowledgeGraphV2;

try {
  const raw = fs.readFileSync(graphFilePath, 'utf8');
  graphData = JSON.parse(raw);
} catch (e) {
  throw new Error(`无法读取知识图谱文件 ${graphFilePath}: ${e}`);
}

const stats = graphData.stats;
const totalNodes = stats.nodesCount;
const totalEdges = stats.edgesCount;
const totalEvidence = stats.evidenceEntriesCount || 798;
const baseUrl = import.meta.env.BASE_URL;
---

<Base title="科研知识关联图 V2 | PhytoMethods">
  <div class="knowledge-v2-container" id="knowledge-explorer-app" data-base-url={baseUrl}>
    <!-- 顶部状态栏 -->
    <KnowledgeHeader 
      totalNodes={totalNodes} 
      totalEdges={totalEdges} 
      totalEvidence={totalEvidence} 
    />

    <!-- 三栏主探索区 -->
    <main class="explorer-main">
      <!-- 左栏：控制与多维检索 -->
      <KnowledgeFilterPanel nodesByType={stats.nodesByType} />

      <!-- 中栏：网络拓扑画布 -->
      <KnowledgeCanvas />

      <!-- 右栏：实体与科学证据详情 -->
      <KnowledgeInspector 
        totalNodes={totalNodes} 
        totalEdges={totalEdges} 
        totalEvidence={totalEvidence} 
      />
    </main>

    <!-- 内联全量知识图谱数据，保证零网络延迟且支持离线/静态发布 -->
    <script id="knowledge-graph-data" type="application/json" set:html={JSON.stringify(graphData)}></script>
  </div>
</Base>

<script>
  import { KnowledgeGraphClient } from '../../lib/knowledge/graph-client';
  import type { KnowledgeGraphV2 } from '../../lib/knowledge/graph-types';

  document.addEventListener('DOMContentLoaded', () => {
    const container = document.getElementById('knowledge-explorer-app');
    const dataScript = document.getElementById('knowledge-graph-data');
    if (!container || !dataScript) return;

    try {
      const graphData: KnowledgeGraphV2 = JSON.parse(dataScript.textContent || '{}');
      const baseUrl = container.dataset.baseUrl || '/';
      new KnowledgeGraphClient(container, graphData, baseUrl);
    } catch (err) {
      console.error('初始化知识关联图探索器失败:', err);
    }
  });
</script>
