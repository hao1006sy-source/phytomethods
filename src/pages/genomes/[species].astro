---
import Base from '../../layouts/Base.astro';
import {species,assemblies,annotations,files,fileLabels,accessLabels,databases} from '../../lib/genomes/registry';
import {datasetsCommand} from '../../lib/genomes/downloads';
import '../../styles/genome-hub.css';
export function getStaticPaths(){return species.map(s=>({params:{species:s.id},props:{species:s}}));}
const {species:s}=Astro.props;const versions=assemblies.filter(a=>a.speciesId===s.id);const base=import.meta.env.BASE_URL;
---
<Base title={`${s.chineseName}参考基因组 | Plant Genome Hub`}><div class="gh" id="genome-detail" data-species={s.id}>
<nav><a href={`${base}genomes/`}>Plant Genome Hub</a> / {s.chineseName}</nav>
<section class="gh-hero"><div class="eyebrow">SPECIES · ASSEMBLY · ANNOTATION</div><h1>{s.chineseName}</h1><p><i>{s.scientificName}</i> · {s.strain}</p><p>Taxonomy ID：<a href={`https://www.ncbi.nlm.nih.gov/Taxonomy/Browser/wwwtax.cgi?id=${s.taxonomyId}`}>{s.taxonomyId}</a> · 组装记录分类 ID：{s.assemblyTaxonomyId}</p><div class="gh-tags">{s.databaseIds.map(id=>{const d=databases.find(d=>d.id===id);return d&&<a href={d.url}>{d.name} ↗</a>})}</div></section>
<label>选择参考组装 <select id="assembly-select">{versions.map(a=><option value={a.id}>{a.assemblyName} · {a.accession}</option>)}</select></label>
{s.id==='arabidopsis'&&<p class="gh-warning">TAIR12 / Col-CC.v2（GCA_028009825.2）与 TAIR10 / Araport11（GCA_000001735.1）坐标不兼容。复现旧研究应保留原坐标，AGI 标识相同也不代表位置相同。</p>}
{s.id==='rice'&&<p class="gh-warning">RGAP / MSU Release 7 基于 Os-Nipponbare-Reference-IRGSP-1.0。这里使用包含 TE 和非 TE 模型的全部基因模型，不混用 representative、籼稻或 NCBI 注释。</p>}
{versions.map((a,index)=>{const ann=annotations.find(n=>n.assemblyId===a.id)!;const resource=files.filter(f=>f.assemblyId===a.id);return <section data-assembly-panel={a.id} hidden={index!==0}>
<section class="gh-block"><h2>参考组装与注释版本</h2><dl class="gh-meta"><dt>Assembly</dt><dd>{a.assemblyName} · <strong>{a.accession}</strong> · accession 版本 {a.assemblyVersion}</dd><dt>来源 / 等级</dt><dd>{a.sourceDatabase} / {a.assemblyLevel}</dd><dt>组装发布日期</dt><dd>{'releaseDate'in a&&a.releaseDate?a.releaseDate:'未核实'}</dd><dt>品系 / 坐标</dt><dd>{a.strain} / {a.coordinateSystem}</dd><dt>数据库发布</dt><dd>{a.databaseRelease}</dd><dt>注释版本 / 机构</dt><dd>{ann.releaseName} · {ann.provider}</dd><dt>注释发布日期</dt><dd>{'releaseDate'in ann&&ann.releaseDate?ann.releaseDate:'未核实'}</dd><dt>文件命名核实</dt><dd>{ann.chromosomeNamespace||'尚未核实，配套状态保持未确认'}</dd><dt>核实日期</dt><dd>{a.verifiedAt}</dd></dl><p>{a.note}</p><p>{ann.note}</p><div class="gh-actions"><a href={a.sourceUrl}>官方组装记录 ↗</a><a href={ann.sourceUrl}>注释原始出处 ↗</a></div></section>
<section class="gh-block"><h2>配套文件下载中心</h2><p class="gh-muted">直链通过小段 gzip 文件头验证；页面入口需在原站选择对应发布，未核实文件不参与默认选择。窄屏可横向滑动表格查看下载操作。</p><div class="gh-scroll"><table class="gh-files"><thead><tr><th>选择</th><th>资源</th><th>获取方式</th><th>操作</th></tr></thead><tbody>{resource.map(f=><tr><td><input aria-label={`选择 ${fileLabels[f.type]}`} type="checkbox" data-resource-id={f.id} checked={(f.type==='genome'&&f.accessType!=='unverified')||(f.accessType==='direct'&&['gff3','cds','protein'].includes(f.type))} disabled={f.accessType==='unverified'}/></td><td>{fileLabels[f.type]}<br/><small>{f.format} · {ann.releaseName}</small></td><td>{accessLabels[f.accessType]}</td><td>{f.accessType!=='unverified'&&<><a href={'downloadUrl'in f&&f.downloadUrl?f.downloadUrl:f.sourceUrl} target="_blank" rel="noreferrer">{f.accessType==='direct'?'下载文件 ↗':'打开官方页面 ↗'}</a> <button data-copy-url={'downloadUrl'in f&&f.downloadUrl?f.downloadUrl:f.sourceUrl}>{f.accessType==='direct'?'复制下载链接':'复制入口'}</button>{f.accessType==='direct'&&<button data-copy-url={`curl --fail --location --retry 3 -O '${'downloadUrl'in f?f.downloadUrl:''}'`}>复制命令</button>}</>}<details><summary>文件说明</summary><p>{f.note}</p><a href={f.sourceUrl}>来源依据</a></details></td></tr>)}</tbody></table></div><div class="gh-status" data-selection-status role="status"></div><div class="gh-actions"><button class="primary" data-export-manifest>导出 reference-manifest.json</button><button data-copy-citation>复制 Markdown 引用清单</button></div></section>
<section class="gh-block"><h2>NCBI Datasets 命令</h2><pre data-cli>{datasetsCommand(a)}</pre><button data-copy-cli disabled={a.sourceDatabase==='ensembl'}>复制 NCBI 命令</button><p class="gh-warning">这是独立的 NCBI 数据包入口，TAIR、RGAP、Ensembl 注释不通过此命令获取。NCBI 序列命名不能与外部注释自动混配。下载包不保证包含缺失文件，请核对 assembly_data_report.json 的实际注释发布。</p></section>
</section>})}
<section class="gh-block"><h2>跨版本配套检查</h2><p>比较当前组装的 Genome 与其他注释记录。</p><label>比较注释 <select id="annotation-compare">{annotations.map(n=><option value={n.id}>{species.find(s=>s.id===assemblies.find(a=>a.id===n.assemblyId)?.speciesId)?.chineseName} · {n.releaseName} · {assemblies.find(a=>a.id===n.assemblyId)?.accession}</option>)}</select></label><p class="gh-status" id="comparison-status" role="status"></p></section>
<p id="genome-feedback" role="status" aria-live="polite"></p><p><a href={`${base}genomes/databases/`}>官方数据库导航</a> · <a href={`${base}tutorials/`}>分析教程</a> · <a href={`${base}topics/`}>研究领域</a></p>
</div><script src="../../scripts/genome-detail.ts"></script></Base>
