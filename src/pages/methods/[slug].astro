---
import Base from '../../layouts/Base.astro';import ArticleShell from '../../components/ArticleShell.astro';import Diagram from '../../components/Diagram.astro';import ScientificFigure from '../../components/ScientificFigure.astro';
import {topicMetadata} from '../../data/topics';
import { getCollection, render } from 'astro:content';
export async function getStaticPaths(){return (await getCollection('methods',({data})=>data.status==='published')).map(entry=>({params:{slug:entry.id},props:{entry}}));}
const {entry}=Astro.props;const {Content,headings}=await render(entry);const papers=await getCollection('papers',({data})=>data.status==='published');const tutorials=await getCollection('tutorials',({data})=>data.status==='published');const base=import.meta.env.BASE_URL;
---
<Base title={entry.data.title}><p><a href={`${base}methods/`}>算法与工具</a> / {entry.data.name}</p><h1>{entry.data.title}</h1><p>{entry.data.summary}</p><p>数据：{entry.data.dataType} · 原理：{entry.data.principle}</p><ArticleShell headings={headings}><Diagram kind={entry.id}/>{entry.id==='merqury' && <ScientificFigure kind="spectrum"/>}<article class="prose"><Content /></article><h2>相关专题</h2><p>{topicMetadata.filter(t=>t.status==='published'&&t.methodIds.includes(entry.id)).map(t=><a href={`${base}topics/${t.domainId}/${t.id}/`}>{t.title}　</a>)}</p><h2>相关文献与教程</h2><ul>{papers.filter(p=>p.data.methodIds.includes(entry.id)).map(p=><li><a href={`${base}papers/${p.id}/`}>{p.data.title}</a></li>)}{tutorials.filter(t=>t.data.method===entry.id).map(t=><li><a href={`${base}tutorials/${t.id}/`}>{t.data.title}</a></li>)}</ul></ArticleShell><p><a href={`${base}papers/${entry.data.paper}/`}>方法论文</a> · <a href={`${base}tutorials/`}>分析教程</a> · <a href={entry.data.repository}>官方仓库</a></p></Base>
