---
import Base from '../../layouts/Base.astro';import DraftPreview from '../../components/DraftPreview.astro';import ArticleShell from '../../components/ArticleShell.astro';import Diagram from '../../components/Diagram.astro';import ScientificFigure from '../../components/ScientificFigure.astro';
import {topicMetadata} from '../../data/topics';
import {domains} from '../../data/domains';
import { getCollection, render } from 'astro:content';
export async function getStaticPaths(){return (await getCollection('methods',({data})=>data.status==='published'||import.meta.env.DEV)).map(entry=>({params:{slug:entry.id},props:{entry}}));}
const {entry}=Astro.props;const {Content,headings}=await render(entry);const papers=await getCollection('papers',({data})=>data.status==='published'||import.meta.env.DEV);const tutorials=await getCollection('tutorials',({data})=>data.status==='published'||import.meta.env.DEV);const base=import.meta.env.BASE_URL;const domainTitle=domains.find(d=>d[1]===entry.data.domainIds[0])?.[2] ?? entry.data.domainIds[0];
---
<Base title={entry.data.title}><DraftPreview status={entry.data.status}/><p class="breadcrumb"><a href={`${base}methods/`}>算法与工具</a> / {entry.data.name}</p><div class="resource-heading"><span class="resource-type">算法与工具</span><h1>{entry.data.title}</h1><p class="page-lead">{entry.data.summary}</p><div class="resource-meta"><span>研究领域 <b>{domainTitle}</b></span>{entry.data.version && <span>软件版本 <b>{entry.data.version}</b></span>}<span>输入数据 <b>{entry.data.dataType}</b></span><span>计算原理 <b>{entry.data.principle}</b></span></div><div class="resource-actions"><a href={entry.data.repository}>官方网站或代码 ↗</a><a href={`${base}papers/${entry.data.paper}/`}>方法论文</a><a href={`${base}tutorials/`}>分析教程</a></div></div><ArticleShell headings={headings} domain={entry.data.domainIds[0]}>{['hifiasm','verkko','merqury'].includes(entry.id) && <Diagram kind={entry.id}/>}{entry.id==='merqury' && <ScientificFigure kind="spectrum"/>}<article class="prose"><Content /></article><h2>相关专题</h2><p>{topicMetadata.filter(t=>(t.status==='published'||import.meta.env.DEV)&&t.methodIds.includes(entry.id)).map(t=><a href={`${base}topics/${t.domainId}/${t.id}/`}>{t.title}　</a>)}</p><h2>相关文献与教程</h2><ul>{papers.filter(p=>p.data.methodIds.includes(entry.id)).map(p=><li><a href={`${base}papers/${p.id}/`}>{p.data.title}</a></li>)}{tutorials.filter(t=>t.data.method===entry.id).map(t=><li><a href={`${base}tutorials/${t.id}/`}>{t.data.title}</a></li>)}</ul></ArticleShell><p><a href={`${base}papers/${entry.data.paper}/`}>方法论文</a> · <a href={`${base}tutorials/`}>分析教程</a> · <a href={entry.data.repository}>官方网站或代码</a></p></Base>

<style>.resource-heading{background:#fff;border:1px solid var(--border);border-radius:12px;padding:36px 40px}.resource-type{color:var(--teal);font-size:.78rem;font-weight:700}.resource-heading h1{margin:8px 0 12px}.resource-meta{display:flex;flex-wrap:wrap;gap:24px;margin:24px 0;color:var(--muted);font-size:.8rem}.resource-meta b{display:block;color:var(--ink);font-size:.9rem;margin-top:4px}.resource-actions{display:flex;gap:10px;flex-wrap:wrap}.resource-actions a{border:1px solid var(--border);padding:8px 14px;border-radius:7px;text-decoration:none;font-size:.85rem;font-weight:700}.resource-actions a:first-child{background:var(--teal);border-color:var(--teal);color:#fff}@media(max-width:700px){.resource-heading{padding:24px}.resource-meta{gap:16px}}</style>
