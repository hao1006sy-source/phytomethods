---
import MethodPageLayout from '../../components/method-v3/MethodPageLayout.astro';
import HifiasmPageV3 from '../../components/method-v3/HifiasmPageV3.astro';
import Base from '../../layouts/Base.astro';
import DraftPreview from '../../components/DraftPreview.astro';
import { getCollection } from 'astro:content';

export async function getStaticPaths() {
  const entries = await getCollection('methods', ({ data }) => data.status === 'published' || import.meta.env.DEV);
  return entries.map((entry) => ({ params: { slug: entry.id }, props: { entry } }));
}

const allMethods = await getCollection('methods', ({ data }) => data.status === 'published' || import.meta.env.DEV);
const { entry } = Astro.props;
const papers = await getCollection('papers', ({ data }) => data.status === 'published' || import.meta.env.DEV);
const tutorials = await getCollection('tutorials', ({ data }) => data.status === 'published' || import.meta.env.DEV);
---

<Base title={entry.data.title} description={entry.data.summary} content={entry.body}>
  <DraftPreview status={entry.data.status} />
  {entry.id === 'hifiasm'
    ? <HifiasmPageV3 entry={entry} papers={papers} tutorials={tutorials} methods={allMethods} />
    : <MethodPageLayout entry={entry} papers={papers} tutorials={tutorials} methods={allMethods} />}
</Base>
