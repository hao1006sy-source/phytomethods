---
import Base from '../../layouts/Base.astro';import {getCollection} from 'astro:content';import {domains} from '../../data/domains';import {principleLabels,dataLabels} from '../../data/tags';
const entries=await getCollection('methods',({data})=>data.status==='published');const topics=await getCollection('topics',({data})=>data.status==='published');const base=import.meta.env.BASE_URL;
---
<Base title="算法与工具" description="植物基因组学常用算法与生信工具索引，收录 Hifiasm、EDTA、OrthoFinder、PLINK 等 58 款主流软件，支持按研究领域、算法原理和数据类型多维筛选。"><section class="nav-v3"><header class="nav-intro"><div><p class="nav-overline">METHODS & TOOLS</p><h1>算法与工具</h1><p>按研究领域、底层计算原理和数据类型寻找适用的方法，并进入详细原理与文献页面。</p></div><p class="nav-metric"><b>{entries.length}</b> 已收录记录</p></header><div class="nav-explorer"><form id="filters" class="filters"><h2>精确筛选</h2><label>研究领域 <select name="domain"><option value="">全部</option>{domains.map(d=><option value={d[1]}>{d[2]}</option>)}</select></label><label>专题 <select name="topic"><option value="">全部</option>{topics.map(t=><option value={t.id}>{t.data.title}</option>)}</select></label><label>算法原理 <select name="principle"><option value="">全部</option>{Object.entries(principleLabels).map(([id,label])=><option value={id}>{label}</option>)}</select></label><label>输入数据 <select name="data"><option value="">全部</option>{Object.entries(dataLabels).map(([id,label])=><option value={id}>{label}</option>)}</select></label><button type="reset">重置筛选</button></form><div class="nav-results"><div class="nav-searchbar"><label>关键词 <input form="filters" name="q" id="filter" type="search" placeholder="工具名称或关键词"/></label></div><p id="filter-count" aria-live="polite"></p><div class="list-view">{entries.map((e,index)=><article class="card filter-item" data-q={`${e.data.name} ${e.data.summary} ${e.data.principle} ${e.data.dataType}`} data-domain={e.data.domainIds.join('|')} data-topic={e.data.topicIds.join('|')} data-principle={e.data.principleIds.join('|')} data-data={e.data.dataIds.join('|')}><span class="result-index">{String(index+1).padStart(2,'0')}</span><h2><a href={`${base}methods/${e.id}/`}>{e.data.name}</a></h2><p>{e.data.summary}</p><p><span class="nav-tag">{e.data.dataType}</span> {e.data.principle}</p><a class="result-go" href={`${base}methods/${e.id}/`}>查看方法 →</a></article>)}</div></div></div></section><script src="../../scripts/filters.ts"></script></Base>
