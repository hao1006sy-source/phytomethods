---
import Base from '../../layouts/Base.astro';import {getCollection} from 'astro:content';import {domains} from '../../data/domains';import {principleLabels,dataLabels} from '../../data/tags';
const entries=await getCollection('methods',({data})=>data.status==='published');const topics=await getCollection('topics',({data})=>data.status==='published');const base=import.meta.env.BASE_URL;
---
<Base title="算法与工具"><h1>算法与工具</h1><form id="filters" class="filters"><label>关键词 <input name="q" id="filter" type="search" placeholder="工具名称或关键词"/></label><label>研究领域 <select name="domain"><option value="">全部</option>{domains.map(d=><option value={d[1]}>{d[2]}</option>)}</select></label><label>专题 <select name="topic"><option value="">全部</option>{topics.map(t=><option value={t.id}>{t.data.title}</option>)}</select></label><label>算法原理 <select name="principle"><option value="">全部</option>{Object.entries(principleLabels).map(([id,label])=><option value={id}>{label}</option>)}</select></label><label>输入数据 <select name="data"><option value="">全部</option>{Object.entries(dataLabels).map(([id,label])=><option value={id}>{label}</option>)}</select></label><button type="reset">重置筛选</button></form><p id="filter-count" aria-live="polite"></p><div class="list-view">{entries.map(e=><article class="card filter-item" data-q={`${e.data.name} ${e.data.summary} ${e.data.principle} ${e.data.dataType}`} data-domain={e.data.domainIds.join('|')} data-topic={e.data.topicIds.join('|')} data-principle={e.data.principleIds.join('|')} data-data={e.data.dataIds.join('|')}><h2><a href={`${base}methods/${e.id}/`}>{e.data.name}</a></h2><p>{e.data.summary}</p><p>{e.data.dataType} · {e.data.principle}</p></article>)}</div><script src="../../scripts/filters.ts"></script></Base>
