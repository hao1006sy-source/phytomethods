---
import { getCollection, render } from 'astro:content';
import Base from '../../../layouts/Base.astro';
import DraftPreview from '../../../components/DraftPreview.astro';
import TopicArticleLayout from '../../../components/article-v2/TopicArticleLayout.astro';
import TopicArticleFigures from '../../../components/article-v2/TopicArticleFigures.astro';
import SequencingReadLengthFigure from '../../../components/article-v2/SequencingReadLengthFigure.astro';
import { topicMetadata } from '../../../data/topics';
import { getTopicArticleHighlights } from '../../../data/topic-article-v2';

export async function getStaticPaths() {
  const entries = await getCollection('topics', ({ data }) => data.status === 'published' && data.domain === 'genome-assembly');
  return entries.map((entry) => ({ params: { slug: entry.id }, props: { entry } }));
}

const { entry } = Astro.props;
const { Content, headings } = await render(entry);
const metadata = topicMetadata.find((topic) => topic.id === entry.id);
if (!metadata) throw new Error(`Missing topic metadata for ${entry.id}`);
const topicEntries = await getCollection('topics', ({ data }) => data.status === 'published' && data.domain === entry.data.domain);
const methods = await getCollection('methods', ({ data }) => data.status === 'published');
const papers = await getCollection('papers', ({ data }) => data.status === 'published');
const tutorials = await getCollection('tutorials', ({ data }) => data.status === 'published');
const relatedMethods = methods.filter((method) => metadata.methodIds.includes(method.id));
const relatedPapers = papers.filter((paper) => metadata.paperIds.includes(paper.id));
const relatedTutorials = tutorials.filter((tutorial) => metadata.tutorialIds.includes(tutorial.id));
---
<Base title={entry.data.title}>
  <DraftPreview status={entry.data.status} />
  <TopicArticleLayout
    entry={entry}
    metadata={metadata}
    headings={headings}
    topicEntries={topicEntries}
    relatedMethods={relatedMethods}
    relatedPapers={relatedPapers}
    relatedTutorials={relatedTutorials}
    highlights={getTopicArticleHighlights(metadata)}
  >
    <Content />
    <TopicArticleFigures topicId={entry.id} domainId={entry.data.domain} />
    {entry.id === 'sequencing-data' && <SequencingReadLengthFigure slot="after-first-table" />}
  </TopicArticleLayout>
</Base>
