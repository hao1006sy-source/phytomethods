---
import Base from '../../../layouts/Base.astro';import ArticleShell from '../../../components/ArticleShell.astro';import Diagram from '../../../components/Diagram.astro';import ScientificFigure from '../../../components/ScientificFigure.astro';import HaplotypeDemo from '../../../components/HaplotypeDemo.astro';import AssemblyFigures from '../../../components/AssemblyFigures.astro';import {topicMetadata} from '../../../data/topics';import {getCollection,render} from 'astro:content';export async function getStaticPaths(){return (await getCollection('topics',({data})=>data.status==='published')).map(entry=>({params:{slug:entry.id},props:{entry}}));}const {entry}=Astro.props;const {Content,headings}=await render(entry);const base=import.meta.env.BASE_URL;const order=['sequencing-data','assembly-basics','assembly-graphs','haplotype-resolution','hic-scaffolding','complete-assembly','assembly-quality'];const pos=order.indexOf(entry.id);const meta=topicMetadata.find(t=>t.id===entry.id)!;const papers=await getCollection('papers',({data})=>data.status==='published');const tutorials=await getCollection('tutorials',({data})=>data.status==='published');const names:Record<string,string>={'sequencing-data':'测序技术与原始数据','assembly-basics':'基因组组装基础','hic-scaffolding':'Hi-C 辅助染色体挂载','complete-assembly':'T2T 与复杂区域组装','assembly-graphs':'组装图与核心算法','haplotype-resolution':'单倍型解析','assembly-quality':'组装质量评估'};
---
<Base title={entry.data.title}><p class="breadcrumb"><a href={`${base}topics/genome-assembly/`}>测序与基因组组装</a> / {entry.data.title}</p><h1>{entry.data.title}</h1><p class="page-lead">{entry.data.summary}</p><ArticleShell headings={headings} current={entry.id}><article class="prose"><Content/></article>{['assembly-graphs','haplotype-resolution','assembly-quality'].includes(entry.id) && <Diagram kind={entry.id==='assembly-graphs'?'graphs':entry.id==='haplotype-resolution'?'haplotypes':'merqury'}/>}{['haplotype-resolution','assembly-quality'].includes(entry.id) && <ScientificFigure kind={entry.id==='haplotype-resolution'?'haplotypes':'spectrum'}/>}{['sequencing-data','assembly-basics'].includes(entry.id) && <Diagram kind="assembly"/>}{['hic-scaffolding','complete-assembly'].includes(entry.id) && <AssemblyFigures kind={entry.id}/>}{entry.id==='haplotype-resolution' && <HaplotypeDemo/>}{entry.id==='assembly-graphs' && <section class="card"><h2>组装图交互示意</h2><p>示意数据：观察 reads 如何形成连接与分叉。</p><svg viewBox="0 0 600 110" role="img" aria-label="组装图教学示意"><path id="diagram" d="M30 55 H170 M200 55 H320" stroke="#347b70" stroke-width="5" fill="none"/><text x="25" y="40">Read A</text><text x="180" y="40">Read B</text><text x="330" y="40">候选路径</text></svg><p id="explanation" aria-live="polite">第 1 步：读取重叠的序列片段。</p><button id="prev">上一步</button> <button id="next">下一步</button> <button id="reset">重置</button></section>}<h2>相关工具</h2><p>{meta.methodIds.map(m=><a href={`${base}methods/${m}/`}>{m}　</a>)}{meta.methodIds.length===0 && <a href={`${base}methods/`}>工具目录</a>}</p><h2>相关文献和教程</h2><ul>{papers.filter(p=>meta.paperIds.includes(p.id)).map(p=><li><a href={`${base}papers/${p.id}/`}>{p.data.title}</a></li>)}{tutorials.filter(t=>meta.tutorialIds.includes(t.id)).map(t=><li><a href={`${base}tutorials/${t.id}/`}>{t.data.title}</a></li>)}</ul><p><a href={`${base}papers/`}>浏览文献索引</a> · <a href={`${base}tutorials/`}>浏览分析教程</a></p><nav aria-label="专题前后导航">{pos>0 && <a href={`${base}topics/genome-assembly/${order[pos-1]}/`}>上一篇：{names[order[pos-1]]}</a>}　{pos<order.length-1 && <a href={`${base}topics/genome-assembly/${order[pos+1]}/`}>下一篇：{names[order[pos+1]]}</a>}</nav></ArticleShell><script>let step=0;const paths=['M30 55 H170 M200 55 H320','M30 55 H320','M30 55 H320 M320 55 L520 20 M320 55 L520 90'];const labels=['第 1 步：读取重叠的序列片段。','第 2 步：识别重叠并连接片段。','第 3 步：重复序列或变异形成候选分叉。'];function draw(){document.querySelector('#diagram')?.setAttribute('d',paths[step]);const e=document.querySelector('#explanation');if(e)e.textContent=labels[step];}document.querySelector('#prev')?.addEventListener('click',()=>{step=Math.max(0,step-1);draw()});document.querySelector('#next')?.addEventListener('click',()=>{step=Math.min(2,step+1);draw()});document.querySelector('#reset')?.addEventListener('click',()=>{step=0;draw()});</script></Base>
