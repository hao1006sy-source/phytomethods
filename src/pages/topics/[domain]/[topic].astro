---
import CoexpressionDemo from '../../../components/CoexpressionDemo.astro';import MethylationFigure from '../../../components/MethylationFigure.astro';import Base from '../../../layouts/Base.astro';import GwasDemo from '../../../components/GwasDemo.astro';import MixedModelFigure from '../../../components/MixedModelFigure.astro';import PopulationPcaDemo from '../../../components/PopulationPcaDemo.astro';import PhylogenyDemo from '../../../components/PhylogenyDemo.astro';import WgdDemo from '../../../components/WgdDemo.astro';import CollinearityDemo from '../../../components/CollinearityDemo.astro';import GeneEvolutionDemo from '../../../components/GeneEvolutionDemo.astro';import GraphMappingDemo from '../../../components/GraphMappingDemo.astro';import AnchorChainDemo from '../../../components/AnchorChainDemo.astro';import PangenomeFigure from '../../../components/PangenomeFigure.astro';import PangenomeDemo from '../../../components/PangenomeDemo.astro';import {domains} from '../../../data/domains';import ArticleShell from '../../../components/ArticleShell.astro';import AnnotationFigure from '../../../components/AnnotationFigure.astro';import {topicMetadata} from '../../../data/topics';import {getCollection,render} from 'astro:content';
export async function getStaticPaths(){return (await getCollection('topics',({data})=>data.status==='published' && data.domain!=='genome-assembly')).map(entry=>({params:{domain:entry.data.domain,topic:entry.id},props:{entry}}));}
const {entry}=Astro.props;const domainTitle=domains.find(d=>d[1]===entry.data.domain)?.[2] ?? '研究领域';const {Content,headings}=await render(entry);const base=import.meta.env.BASE_URL;const meta=topicMetadata.find(t=>t.id===entry.id)!;const related=topicMetadata.filter(t=>t.domainId===entry.data.domain&&t.status==='published').sort((a,b)=>a.order-b.order);const pos=related.findIndex(t=>t.id===entry.id);const papers=await getCollection('papers',({data})=>data.status==='published');const tutorials=await getCollection('tutorials',({data})=>data.status==='published');
---
<Base title={entry.data.title}><p class="breadcrumb"><a href={`${base}topics/${entry.data.domain}/`}>{domainTitle}</a> / {entry.data.title}</p><h1>{entry.data.title}</h1><p class="page-lead">{entry.data.summary}</p><ArticleShell headings={headings} current={entry.id} domain={entry.data.domain}><article class="prose"><Content/></article>{entry.data.domain==='genome-annotation' && <AnnotationFigure kind={entry.id}/>}{entry.id==='m03-topic-05' && <PangenomeDemo/>}{entry.id==='m03-topic-02' && <AnchorChainDemo/>}{entry.id==='m03-topic-06' && <GraphMappingDemo/>}{entry.id==='m04-topic-01' && <GeneEvolutionDemo/>}{entry.id==='m04-topic-03' && <CollinearityDemo/>}{entry.id==='m04-topic-06' && <WgdDemo/>}{entry.id==='m04-topic-04' && <PhylogenyDemo/>}{entry.id==='m05-topic-03' && <PopulationPcaDemo/>}{entry.id==='m06-topic-04' && <MixedModelFigure/>}{entry.id==='m06-topic-05' && <GwasDemo/>}{entry.id==='m07-topic-02' && <MethylationFigure/>}{entry.id==='m09-topic-02' && <CoexpressionDemo/>}{['m03-topic-01','m03-topic-03','m03-topic-04','m03-topic-07'].includes(entry.id) && <PangenomeFigure kind={entry.id}/>}<h2>相关工具</h2><p>{meta.methodIds.map(m=><a href={`${base}methods/${m}/`}>{m}　</a>)}{meta.methodIds.length===0 && <a href={`${base}methods/`}>浏览工具目录</a>}</p><h2>相关文献与教程</h2><ul>{papers.filter(p=>meta.paperIds.includes(p.id)).map(p=><li><a href={`${base}papers/${p.id}/`}>{p.data.title}</a></li>)}{tutorials.filter(t=>meta.tutorialIds.includes(t.id)).map(t=><li><a href={`${base}tutorials/${t.id}/`}>{t.data.title}</a></li>)}</ul><nav aria-label="专题前后导航">{pos>0 && <a href={`${base}topics/${entry.data.domain}/${related[pos-1].id}/`}>上一篇：{related[pos-1].title}</a>}{pos<related.length-1 && <a href={`${base}topics/${entry.data.domain}/${related[pos+1].id}/`}>下一篇：{related[pos+1].title}</a>}</nav></ArticleShell></Base>
