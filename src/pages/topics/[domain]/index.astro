---
import M01Domain from '../../../components/domain-v2/M01Domain.astro';
import DomainPageV2 from '../../../components/domain-v2/DomainPageV2.astro';
import Base from '../../../layouts/Base.astro';
import { domains } from '../../../data/domains';

export function getStaticPaths() {
  return domains.map((domain) => ({ params: { domain: domain[1] }, props: { domain } }));
}
const { domain } = Astro.props;
const [id, , title] = domain;
---

<Base title={title}>{id === 'M01' ? <M01Domain /> : <DomainPageV2 domain={domain} />}</Base>
