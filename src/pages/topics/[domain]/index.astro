---
import Base from '../../../layouts/Base.astro';import AssemblyOverview from '../../../components/AssemblyOverview.astro';import Diagram from '../../../components/Diagram.astro';import {domains} from '../../../data/domains';import {topicLists,publishedTopics,topicMetadata} from '../../../data/topics';
export function getStaticPaths(){return domains.map(d=>({params:{domain:d[1]},props:{domain:d}}));}const {domain}=Astro.props;const [id,slug,title,summary]=domain;const base=import.meta.env.BASE_URL;const english=topicMetadata.find(t=>t.domainId===slug)?.domainId.replaceAll('-',' ');
---
<Base title={title}><p class="breadcrumb"><a href={`${base}topics/`}>研究领域</a> / {title}</p><section class="domain-heading"><div><span class="domain-badge">{id} · 研究领域</span><h1>{title}</h1><p class="domain-en">{english}</p><p class="page-lead">{summary}。</p></div><div class="domain-heading-aside"><span>研究路径</span><strong>从基础概念到分析实践</strong><p>专题、工具、论文与教程相互关联，支持按研究问题查阅。</p></div></section>{id==='M01' && <section class="domain-flow"><div class="mini-heading"><span>技术路线</span><h2>从测序数据到染色体</h2></div><Diagram kind="assembly"/></section>}<section class="topic-section"><div class="mini-heading"><span>知识目录</span><h2>专题内容</h2><p>按顺序建立基础，也可直接进入感兴趣的专题。</p></div><div class="topic-list">{topicLists[slug].map((t,i)=><article class="topic-row"><span class="topic-number">{String(i+1).padStart(2,'0')}</span><div><h3>{t}</h3><p>{topicMetadata.find(x=>x.domainId===slug&&x.order===i+1)?.summary}</p></div>{slug==='genome-assembly'&&publishedTopics[i]?<a href={`${base}topics/${slug}/${publishedTopics[i]}/`}>阅读专题 <span aria-hidden="true">→</span></a>:<span class="planned">筹备中</span>}</article>)}</div></section>{id==='M01' && <><section class="overview-section"><div class="mini-heading"><span>领域导读</span><h2>研究背景与方法</h2></div><div class="overview-copy"><AssemblyOverview/></div></section><section class="domain-resources"><h2>继续探索</h2><div><a href={`${base}methods/`}><strong>算法与工具</strong><span>查找组装与质量评估方法 →</span></a><a href={`${base}papers/`}><strong>方法学文献</strong><span>阅读原始论文与研究案例 →</span></a><a href={`${base}tutorials/`}><strong>分析教程</strong><span>从示例命令进入实践 →</span></a></div></section></>}</Base>
<style>.domain-heading{background:white;border:1px solid var(--border);border-radius:14px;padding:40px;display:grid;grid-template-columns:1fr 270px;gap:48px}.domain-badge{display:inline-block;color:var(--teal);font-size:.78rem;font-weight:750;background:#eaf5f2;padding:5px 10px;border-radius:5px;margin-bottom:20px}.domain-heading h1{margin-bottom:6px}.domain-en{text-transform:capitalize;color:#94a6b1;font-size:.86rem;margin:0 0 18px}.domain-heading-aside{border-left:1px solid var(--border);padding-left:32px;color:var(--muted);font-size:.86rem}.domain-heading-aside span{display:block;color:var(--teal);font-size:.78rem;font-weight:700;margin-bottom:8px}.domain-heading-aside strong{display:block;color:var(--navy);font-size:1rem;margin-bottom:8px}.domain-flow,.topic-section,.overview-section,.domain-resources{margin-top:64px}.mini-heading>span{font-size:.78rem;color:var(--teal);font-weight:700}.mini-heading h2{margin:4px 0 8px;font-size:1.6rem}.mini-heading p{font-size:.9rem;color:var(--muted)}.domain-flow :global(figure){margin-top:20px!important}.topic-list{margin-top:24px;border-top:1px solid var(--border)}.topic-row{display:grid;grid-template-columns:55px 1fr auto;gap:20px;align-items:center;padding:20px 12px;border-bottom:1px solid var(--border)}.topic-number{color:#9babb6;font-weight:700;font-size:.85rem}.topic-row h3{font-size:1.05rem;margin:0 0 4px}.topic-row p{margin:0;color:var(--muted);font-size:.85rem}.topic-row>a{font-size:.82rem;font-weight:700;text-decoration:none}.planned{color:#9ba9b3;font-size:.8rem}.overview-section{display:grid;grid-template-columns:230px minmax(0,780px);gap:48px}.overview-copy{padding:32px 40px;background:#fff;border:1px solid var(--border);border-radius:12px}.overview-copy :global(h2){font-size:1.18rem;margin:1.8em 0 .7em}.overview-copy :global(h2:first-child){margin-top:0}.overview-copy :global(p){line-height:1.95}.domain-resources>div{display:grid;grid-template-columns:repeat(3,1fr);gap:16px}.domain-resources a{display:flex;flex-direction:column;gap:8px;border:1px solid var(--border);background:#fff;border-radius:10px;padding:22px;text-decoration:none}.domain-resources strong{color:var(--navy)}.domain-resources span{color:var(--teal);font-size:.83rem}@media(max-width:700px){.domain-heading{grid-template-columns:1fr;padding:24px;gap:12px}.domain-heading-aside{border-left:0;border-top:1px solid var(--border);padding:18px 0 0}.domain-flow,.topic-section,.overview-section,.domain-resources{margin-top:48px}.topic-row{grid-template-columns:36px 1fr;gap:10px;padding:16px 0}.topic-row>a,.planned{grid-column:2}.overview-section{display:block}.overview-copy{padding:24px;margin-top:16px}.domain-resources>div{grid-template-columns:1fr}}</style>
