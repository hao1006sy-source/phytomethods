---
import Base from '../../layouts/Base.astro';
import { domains } from '../../data/domains';
const base=import.meta.env.BASE_URL;
---
<Base title="研究领域"><h1>研究领域</h1><div class="grid">{domains.map(([id,slug,title,summary]) => <article class="card"><span class="id">{id}</span><h2>{title}</h2><p>{summary}</p><a href={`${base}topics/${slug}/`}>进入领域 →</a></article>)}</div></Base>
