---
import Base from '../../layouts/Base.astro';import DraftPreview from '../../components/DraftPreview.astro';import {topicMetadata} from '../../data/topics';import ArticleShell from '../../components/ArticleShell.astro';import {getCollection,render} from 'astro:content';export async function getStaticPaths(){return (await getCollection('tutorials',({data})=>data.status==='published'||import.meta.env.DEV)).map(entry=>({params:{slug:entry.id},props:{entry}}));}const {entry}=Astro.props;const {Content,headings}=await render(entry);const base=import.meta.env.BASE_URL;const method=(await getCollection('methods')).find(m=>m.id===entry.data.method);const domain=method?.data.domainIds[0];
---
<Base title={entry.data.title}><DraftPreview status={entry.data.status}/><p class="breadcrumb"><a href={`${base}tutorials/`}>分析教程</a></p><h1>{entry.data.title}</h1><p class="page-lead">{entry.data.summary}</p><ArticleShell headings={headings} domain={domain}><Content/><p><a href={`${base}methods/${entry.data.method}/`}>相关工具</a></p><h2>相关专题</h2><ul>{topicMetadata.filter(t=>(t.status==='published'||import.meta.env.DEV)&&t.tutorialIds.includes(entry.id)).map(t=><li><a href={`${base}topics/${t.domainId}/${t.id}/`}>{t.title}</a></li>)}</ul></ArticleShell></Base>
