---
import HifiasmTutorial from '../../components/tutorial-v3/HifiasmTutorial.astro';
import TutorialV3 from '../../components/tutorial-v3/TutorialV3.astro';
import Base from '../../layouts/Base.astro';
import { getCollection } from 'astro:content';

export async function getStaticPaths() {
  return (await getCollection('tutorials', ({ data }) => data.status === 'published' || import.meta.env.DEV))
    .map(entry => ({ params: { slug: entry.id }, props: { entry } }));
}

const { entry } = Astro.props;
const methods = await getCollection('methods');
const papers = await getCollection('papers');
const method = methods.find(item => item.id === entry.data.method);
const paper = method ? papers.find(item => item.id === method.data.paper) : undefined;
---
<Base title={entry.data.title} description={entry.data.summary}>
  {entry.id === 'hifiasm-intro'
    ? <HifiasmTutorial entry={entry} method={method} paper={paper} />
    : <TutorialV3 entry={entry} method={method} paper={paper} />}
</Base>
