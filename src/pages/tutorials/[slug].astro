---
import Base from '../../layouts/Base.astro';import {getCollection,render} from 'astro:content';export async function getStaticPaths(){return (await getCollection('tutorials',({data})=>data.status==='published')).map(entry=>({params:{slug:entry.id},props:{entry}}));}const {entry}=Astro.props;const {Content}=await render(entry);const base=import.meta.env.BASE_URL;
---
<Base title={entry.data.title}><p><a href={`${base}tutorials/`}>分析教程</a></p><h1>{entry.data.title}</h1><p>{entry.data.summary}</p><Content/><p><a href={`${base}methods/${entry.data.method}/`}>相关工具</a></p></Base>
