---
import Base from '../../layouts/Base.astro';
import {getCollection} from 'astro:content';
import {domains} from '../../data/domains';
import '../../styles/tutorial-index-v4.css';
const entries=(await getCollection('tutorials',({data})=>data.status==='published')).sort((a,b)=>b.data.updatedAt.getTime()-a.data.updatedAt.getTime()||a.data.title.localeCompare(b.data.title,'zh-CN'));
const methods=await getCollection('methods',({data})=>data.status==='published');
const base=import.meta.env.BASE_URL;
const labels={verified:'示例运行已验证',template:'命令模板已核对','not-tested':'尚未运行验证'};
const icons=['m01-genome-assembly','m02-genome-annotation','m03-pangenome-sv','m04-comparative-evolution','m05-population-genetics','m06-gwas-breeding','m07-epigenome-3d','m08-single-cell-spatial','m09-regulatory-ai'];
const tasks=[{id:'construction',label:'基因组组装与注释',domains:['genome-assembly','genome-annotation']},{id:'evolution',label:'比较基因组与结构变异',domains:['comparative-genomics','pangenomics-structural-variation']},{id:'population',label:'群体遗传与 GWAS',domains:['population-genetics','gwas-breeding']},{id:'omics',label:'表观与单细胞分析',domains:['epigenomics-3d-genome','single-cell-spatial-omics']},{id:'regulation',label:'基因调控与网络分析',domains:['regulatory-genomics-ai']}];
// Labels are audited against each tutorial body; absence means no asserted data source.
const sources:Record<string,string>={'bismark-synthetic':'模拟数据','gwas-synthetic':'模拟数据','plink-synthetic':'模拟数据','scanpy-synthetic':'模拟数据','wgcna-synthetic':'模拟数据','syri-intro':'官方拟南芥测试数据','orthofinder-intro':'官方非植物示例','cafe5-intro':'官方非植物示例'};
const cards=entries.map(e=>{const method=methods.find(m=>m.id===e.data.method);const ds=method?.data.domainIds??[];const domain=domains.find(d=>d[1]===ds[0]);return {e,method,ds,domain,groups:tasks.filter(t=>t.domains.some(d=>ds.includes(d))).map(t=>t.id),icon:icons[domains.findIndex(d=>d===domain)]??icons[0]};});
const linkedMethods=[...new Set(entries.map(e=>e.data.method))].map(id=>({id,name:methods.find(m=>m.id===id)?.data.name??id}));
---
<Base title="分析教程" description="从实验数据、计算环境到结果解释，系统学习可复现的植物生物信息学分析流程。">
<section class="tutorial-index-v4">
 <header class="ti-hero"><div><p class="ti-eyebrow">ANALYSIS PROTOCOLS</p><h1>分析教程</h1><p>从实验数据、计算环境到结果解释，系统学习可复现的植物生物信息学分析流程。</p></div><div class="ti-stats">{[[entries.length,'已发布教程','m02-genome-annotation'],[entries.filter(e=>e.data.tested==='verified').length,'示例运行已验证','m08-single-cell-spatial'],[entries.filter(e=>e.data.tested==='template').length,'命令模板已核对','m09-regulatory-ai']].map(([count,label,icon])=><div><img src={`${base}assets/home/icons/${icon}.svg`} alt=""/><p><b>{count}</b><span>{label}</span></p></div>)}</div></header>
 <nav class="ti-tasks" aria-label="按研究任务浏览"><b>按研究任务浏览</b><button type="button" data-task="" aria-pressed="true">全部教程（{entries.length}）</button>{tasks.map(t=><button type="button" data-task={t.id} aria-pressed="false">{t.label}（{cards.filter(c=>c.groups.includes(t.id)).length}）</button>)}</nav>
 <form class="ti-filters" id="tutorial-v4-filters"><label class="ti-search"><span>搜索教程</span><input name="q" type="search" placeholder="搜索教程标题、摘要或工具（如：Hifiasm、GWAS、单细胞）"/></label><label>研究领域<select name="domain"><option value="">全部领域</option>{domains.map(d=><option value={d[1]}>{d[0]} · {d[2]}</option>)}</select></label><label>运行验证状态<select name="tested"><option value="">全部状态</option>{Object.entries(labels).map(([id,label])=><option value={id}>{label}</option>)}</select></label><label>关联工具<select name="method"><option value="">全部工具</option>{linkedMethods.map(m=><option value={m.id}>{m.name}</option>)}</select></label><button type="reset">↻ 重置筛选</button></form>
 <div class="ti-resultbar"><p id="ti-count" aria-live="polite">找到 {entries.length} 篇分析教程</p><label>排序：<select id="ti-sort"><option value="updated">最近更新</option><option value="title">标题排序</option></select></label></div>
 <div class="ti-grid">{cards.map(({e,method,ds,domain,groups,icon})=><a class="ti-card" href={`${base}tutorials/${e.id}/`} data-domain={ds.join('|')} data-method={e.data.method} data-tested={e.data.tested} data-tasks={groups.join('|')} data-q={`${e.data.title} ${e.data.summary} ${method?.data.name??e.data.method}`} data-title={e.data.title} data-updated={e.data.updatedAt.getTime()}><img class="ti-icon" src={`${base}assets/home/icons/${icon}.svg`} alt=""/><div class="ti-copy"><h2>{domain&&<span>{domain[0]}</span>}{e.data.title}</h2><p>{e.data.summary}</p><div class="ti-meta"><span class:list={['ti-state',`ti-state-${e.data.tested}`]}>{e.data.tested==='verified'?'✓':'⌘'} {labels[e.data.tested]}</span><span>{method?.data.name??e.data.method}</span>{sources[e.id]&&<span>{sources[e.id]}</span>}</div></div><strong>查看教程 →</strong></a>)}</div>
 <div class="ti-empty" hidden><h2>未找到符合条件的教程</h2><p>调整关键词或筛选条件，继续查找相关分析流程。</p><button type="button" id="ti-empty-reset">重置筛选</button></div>
 <nav class="ti-explore" aria-label="进一步探索"><div><h2>进一步探索科研方法</h2><p>从工具、研究领域与文献中，发现更多相关的计算方法与应用案例。</p></div>{[['算法与工具','methods/','浏览分析方法与工具'],['研究领域','topics/','探索九大研究方向'],['文献索引','papers/','检索核心研究文献']].map(([title,url,summary])=><a href={`${base}${url}`}><b>{title} →</b><span>{summary}</span></a>)}</nav>
</section><script src="../../scripts/tutorial-index-v4.ts"></script>
</Base>
