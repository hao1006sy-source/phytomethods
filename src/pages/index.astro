---
import type { CollectionEntry } from 'astro:content';
import Base from '../layouts/Base.astro';
import { domains } from '../data/domains';
import homeCuration from '../data/home-curation.json';
import { validateContent } from '../lib/validate-content';
import { getCollection } from 'astro:content';

const methods = await getCollection('methods');
const papers = await getCollection('papers');
const tutorials = await getCollection('tutorials');
const topics = await getCollection('topics');
await validateContent();

const base = import.meta.env.BASE_URL;
const homeAsset = (path: string) => `${base}assets/home/${path}`;
const domainIcons: Record<string, string> = {
  M01: 'm01-genome-assembly.svg',
  M02: 'm02-genome-annotation.svg',
  M03: 'm03-pangenome-sv.svg',
  M04: 'm04-comparative-evolution.svg',
  M05: 'm05-population-genetics.svg',
  M06: 'm06-gwas-breeding.svg',
  M07: 'm07-epigenome-3d.svg',
  M08: 'm08-single-cell-spatial.svg',
  M09: 'm09-regulatory-ai.svg',
};
const latest = <T extends { data: { updatedAt: Date; status: string } }>(items: T[], limit = 3) =>
  items
    .filter((item) => item.data.status === 'published')
    .sort((a, b) => b.data.updatedAt.getTime() - a.data.updatedAt.getTime())
    .slice(0, limit);

const featuredMethods = homeCuration.featuredMethodIds
  .map((id) => methods.find((method) => method.id === id))
  .filter((method): method is CollectionEntry<'methods'> => Boolean(method && method.data.status === 'published'));

const recentPapers = papers
  .filter((paper) => paper.data.status === 'published')
  .map((paper) => ({
    id: paper.id,
    title: paper.data.title,
    href: `${base}papers/${paper.id}/`,
    type: '文献',
    meta: String(paper.data.year),
    updatedAt: paper.data.updatedAt,
  }))
  .sort((a, b) => b.updatedAt.getTime() - a.updatedAt.getTime())
  .slice(0, 2);

const recentTutorials = tutorials
  .filter((tutorial) => tutorial.data.status === 'published')
  .map((tutorial) => ({
    id: tutorial.id,
    title: tutorial.data.title,
    href: `${base}tutorials/${tutorial.id}/`,
    type: '教程',
    meta: tutorial.data.updatedAt.toISOString().slice(0, 10),
    updatedAt: tutorial.data.updatedAt,
  }))
  .sort((a, b) => b.updatedAt.getTime() - a.updatedAt.getTime())
  .slice(0, 2);

const recentResources = [...recentPapers, ...recentTutorials]
  .sort((a, b) => b.updatedAt.getTime() - a.updatedAt.getTime());

const latestTopics = latest(topics, 4);
const searchTerms = homeCuration.popularQueries;
---

<Base title="探索植物基因组学的计算方法" home>
  <div class="home-content">
    <section class="home-hero" aria-labelledby="home-title">
      <div class="hero-copy">
        <h1 id="home-title">探索植物基因组学的计算方法</h1>
        <p class="hero-intro">系统整理研究领域、算法原理、经典文献与可复现分析流程，面向长期学习与科研实践。</p>

        <form class="home-search" action={`${base}search/`} method="get" role="search">
          <label class="sr-only" for="home-query">搜索专题、算法、工具、文献与教程</label>
          <svg class="search-icon" viewBox="0 0 24 24" fill="none" aria-hidden="true">
            <circle cx="10.8" cy="10.8" r="6.8" />
            <path d="m16 16 4.2 4.2" />
          </svg>
          <input id="home-query" name="q" type="search" placeholder="搜索专题、算法、工具、文献与教程…" autocomplete="off" />
          <button type="submit">搜索</button>
        </form>

        <div class="popular-searches" aria-label="热门检索">
          <span class="popular-label">热门检索</span>
          {searchTerms.map((term) => (
            <a href={`${base}search/?q=${encodeURIComponent(term)}`}>{term}</a>
          ))}
        </div>
      </div>

      <div class="hero-botanical">
        <img src={homeAsset('botanical/rice-panicle-photo-v5.png')} alt="" width="1536" height="768" fetchpriority="high" />
      </div>
    </section>

    <section class="home-section domain-section" aria-labelledby="domains-title">
      <div class="section-heading">
        <h2 id="domains-title">九大研究领域</h2>
        <span class="heading-rule" aria-hidden="true"></span>
        <a class="section-more" href={`${base}topics/`}>查看全部领域 <span aria-hidden="true">→</span></a>
      </div>

      <div class="domain-grid">
        {domains.map(([id, slug, title, summary]) => (
          <a class="domain-card" href={`${base}topics/${slug}/`} aria-label={`${id} ${title}：${summary}`}>
            <span class="domain-visual" aria-hidden="true">
              <img src={homeAsset(`icons/${domainIcons[id]}`)} alt="" width="64" height="64" loading="lazy" />
            </span>
            <span class="domain-copy">
              <span class="domain-id">{id}</span>
              <span class="domain-title">{title}</span>
              <span class="domain-summary">{summary}</span>
            </span>
          </a>
        ))}
      </div>
    </section>

    <section class="home-section resource-section" aria-label="精选方法、专题更新、文献与教程">
      <div class="resource-grid">
        <section class="resource-column" aria-labelledby="featured-title">
          <div class="resource-heading">
            <svg viewBox="0 0 28 28" fill="none" aria-hidden="true"><path d="M4 19 10 9l4 6 4-9 6 13H4Z"/><path d="M7 22h14M9 25h10"/></svg>
            <h2 id="featured-title">精选方法与工具</h2>
            <a href={`${base}methods/`} aria-label="浏览全部算法与工具">更多 <span aria-hidden="true">→</span></a>
          </div>
          <ul class="resource-list featured-list">
            {featuredMethods.map((method) => {
              const domain = domains.find((item) => item[1] === method.data.domainIds[0]);
              return (
                <li>
                  <a class="featured-method" href={`${base}methods/${method.id}/`}>
                    <span class="method-name">{method.data.name}</span>
                    <span class="method-domain">{domain?.[0] ?? '方法'}</span>
                    <span class="method-description">{method.data.summary}</span>
                  </a>
                </li>
              );
            })}
          </ul>
        </section>

        <section class="resource-column" aria-labelledby="latest-title">
          <div class="resource-heading">
            <svg viewBox="0 0 28 28" fill="none" aria-hidden="true"><path d="M5 4h13l5 5v15H5z"/><path d="M18 4v6h5M9 14h10M9 18h10"/></svg>
            <h2 id="latest-title">最新更新</h2>
            <a href={`${base}topics/`} aria-label="浏览全部专题">更多 <span aria-hidden="true">→</span></a>
          </div>
          <ul class="resource-list update-list">
            {latestTopics.map((topic) => (
              <li>
                <a class="resource-link" href={`${base}topics/${topic.data.domain}/${topic.id}/`}>
                  <span class="resource-bullet" aria-hidden="true"></span>
                  <span class="resource-title">{topic.data.title}</span>
                  <time datetime={topic.data.updatedAt.toISOString().slice(0, 10)}>{topic.data.updatedAt.toISOString().slice(0, 10)}</time>
                </a>
              </li>
            ))}
          </ul>
        </section>

        <section class="resource-column" aria-labelledby="papers-tutorials-title">
          <div class="resource-heading">
            <svg viewBox="0 0 28 28" fill="none" aria-hidden="true"><path d="M3 8 14 3l11 5-11 5L3 8Z"/><path d="M3 14 14 19l11-5M3 20l11 5 11-5"/></svg>
            <h2 id="papers-tutorials-title">文献与教程</h2>
            <a href={`${base}papers/`} aria-label="浏览文献索引">更多 <span aria-hidden="true">→</span></a>
          </div>
          <ul class="resource-list update-list">
            {recentResources.map((resource) => (
              <li>
                <a class="resource-link resource-link--typed" href={resource.href}>
                  <span class="resource-bullet" aria-hidden="true"></span>
                  <span class="resource-type">{resource.type}</span>
                  <span class="resource-title">{resource.title}</span>
                  <span class="resource-meta">{resource.meta}</span>
                </a>
              </li>
            ))}
          </ul>
        </section>
      </div>
    </section>
  </div>
<aside style="margin:24px 0;padding:20px;border:1px solid #dfebe3;border-radius:12px"><a href={`${base}genomes/`}>Plant Genome Hub · 植物参考基因组与数据库导航 →</a><p>按 Assembly accession 查找参考版本，核对注释配套并导出可复现清单。</p></aside>
</Base>
