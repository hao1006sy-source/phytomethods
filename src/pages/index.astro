---
import Base from '../layouts/Base.astro';
import { domains } from '../data/domains';
import {principleLabels,dataLabels,speciesLabels} from '../data/tags';
import {topicMetadata} from '../data/topics';
import {z} from 'astro/zod';
import { getCollection } from 'astro:content';
const methods=await getCollection('methods'); const papers=await getCollection('papers'); const tutorials=await getCollection('tutorials'); const topics=await getCollection('topics');
const methodIds=new Set(methods.map(x=>x.id));const paperIds=new Set(papers.map(x=>x.id));
for(const m of methods) if(!paperIds.has(m.data.paper)) throw new Error(`无效论文引用：${m.id} → ${m.data.paper}`);
for(const t of [...topics,...tutorials]) for(const id of ('methods' in t.data ? t.data.methods : [t.data.method])) if(!methodIds.has(id)) throw new Error(`无效方法引用：${t.id} → ${id}`);
for(const p of papers) if(p.data.method && !methodIds.has(p.data.method)) throw new Error(`无效方法引用：${p.id}`);
if(new Set(papers.map(p=>p.data.doi.toLowerCase())).size!==papers.length) throw new Error('发现重复 DOI');
const topicIds=new Set(topics.map(x=>x.id));const domainIds=new Set(domains.map(d=>d[1]));
for(const [name,entries] of Object.entries({methods,papers,tutorials,topics})) { const ids=entries.map(e=>e.id);if(new Set(ids).size!==ids.length)throw new Error(`重复 ID: ${name}`); }
for(const m of methods){for(const id of m.data.domainIds)if(!domainIds.has(id as never))throw Error(`无效领域 ${id}`);for(const id of m.data.topicIds)if(!topicIds.has(id))throw Error(`无效专题 ${id}`);for(const id of m.data.principleIds)if(!(id in principleLabels))throw Error(`无效原理标签 ${id}`);for(const id of m.data.dataIds)if(!(id in dataLabels))throw Error(`无效数据标签 ${id}`);}
for(const m of methods.filter(m=>m.data.status==='published')) {
 if(!papers.some(p=>p.id===m.data.paper && p.data.status==='published')) throw Error(`已发布工具引用未发布论文：${m.id}`);
 for(const id of m.data.topicIds) if(!topics.some(t=>t.id===id && t.data.status==='published')) throw Error(`已发布工具引用未发布专题：${m.id} → ${id}`);
}
for(const t of topics.filter(t=>t.data.status==='published')) for(const id of t.data.methods) if(!methods.some(m=>m.id===id && m.data.status==='published')) throw Error(`已发布专题引用未发布工具：${t.id} → ${id}`);
for(const t of tutorials.filter(t=>t.data.status==='published')) if(!methods.some(m=>m.id===t.data.method && m.data.status==='published')) throw Error(`已发布教程引用未发布工具：${t.id}`);
for(const p of papers.filter(p=>p.data.status==='published' && p.data.method)) if(!methods.some(m=>m.id===p.data.method && m.data.status==='published')) throw Error(`已发布论文引用未发布工具：${p.id}`);
for(const t of topics)if(!domainIds.has(t.data.domain as never))throw Error(`无效领域 ${t.data.domain}`);
for(const p of papers){for(const id of p.data.methodIds)if(!methods.some(m=>m.id===id && (p.data.status!=='published'||m.data.status==='published')))throw Error(`无效论文工具关联 ${p.id} → ${id}`);if(!/^10\.\d{4,9}\/\S+$/i.test(p.data.doi))throw Error(`无效 DOI: ${p.id}`);for(const id of p.data.domainIds)if(!domainIds.has(id as never))throw Error(`无效领域 ${id}`);for(const id of p.data.speciesIds)if(!(id in speciesLabels))throw Error(`无效物种 ${id}`);}
const topicMetaSchema=z.object({id:z.string().min(1),title:z.string().min(1),englishTitle:z.string().min(1),domainId:z.string(),order:z.number().int().min(1).max(7),summary:z.string().min(1),keyConcepts:z.array(z.string()).min(1),methodIds:z.array(z.string()),principleIds:z.array(z.string()),dataIds:z.array(z.string()),paperIds:z.array(z.string()),tutorialIds:z.array(z.string()),status:z.enum(['published','draft','planned']),createdAt:z.string().nullable(),updatedAt:z.string().nullable()});
const meta=z.array(topicMetaSchema).length(63).parse(topicMetadata);if(new Set(meta.map(t=>t.id)).size!==63)throw Error('专题元数据 ID 重复');
for(const d of domainIds){const entries=meta.filter(t=>t.domainId===d);if(entries.length!==7 || new Set(entries.map(t=>t.order)).size!==7)throw Error(`专题排序无效 ${d}`);}
for(const t of meta){if(!domainIds.has(t.domainId as never))throw Error(`无效专题领域 ${t.id}`);for(const id of t.methodIds)if(!methodIds.has(id))throw Error(`无效工具 ${id}`);for(const id of t.paperIds)if(!paperIds.has(id))throw Error(`无效论文 ${id}`);for(const id of t.tutorialIds)if(!tutorials.some(x=>x.id===id))throw Error(`无效教程 ${id}`);for(const id of t.principleIds)if(!(id in principleLabels))throw Error(`无效原理 ${id}`);for(const id of t.dataIds)if(!(id in dataLabels))throw Error(`无效数据 ${id}`);if(t.status==='published'&&!topics.some(x=>x.id===t.id&&x.data.status==='published'))throw Error(`缺少专题正文 ${t.id}`);}
const latest=<T extends {data:{updatedAt:Date,status:string}}>(items:T[])=>items.filter(i=>i.data.status==='published').sort((a,b)=>b.data.updatedAt.getTime()-a.data.updatedAt.getTime()).slice(0,3);
const base=import.meta.env.BASE_URL;
---

<Base home><section class="hero"><div class="hero-copy"><div class="hero-kicker"><span class="hero-line"></span> 植物基因组学 · 方法与实践</div><h1>PhytoMethods</h1><h2>植物基因组学与生物信息学方法知识库</h2><p>系统整理植物基因组学的研究领域、核心算法、经典文献与分析教程。</p><form class="hero-search" action={`${base}search/`}><label class="sr-only" for="q">搜索知识库</label><svg width="21" height="21" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><circle cx="10.5" cy="10.5" r="6.5"/><path d="m16 16 4 4"/></svg><input id="q" name="q" placeholder="搜索专题、算法或文献"/><button>搜索</button></form><div class="hero-hints">常用检索 <a href={`${base}search/?q=Hifiasm`}>Hifiasm</a><a href={`${base}search/?q=单倍型`}>单倍型</a><a href={`${base}search/?q=组装`}>基因组组装</a></div></div><div class="hero-aside" aria-hidden="true"><svg viewBox="0 0 300 240" fill="none"><path d="M28 192C76 145 94 78 151 46s93-3 127-24M28 192c60-20 116-21 166-75 36-39 53-42 84-40M28 192c56 0 106 20 157-6 41-21 61-55 93-52" stroke="#75b5a9" stroke-width="1.3"/><g fill="#a9d6c9"><circle cx="28" cy="192" r="5"/><circle cx="151" cy="46" r="4"/><circle cx="194" cy="117" r="4"/><circle cx="185" cy="186" r="4"/><circle cx="278" cy="22" r="3"/><circle cx="278" cy="77" r="3"/><circle cx="278" cy="134" r="3"/></g></svg><span>从数据到发现<br/><small>方法、证据与实践</small></span></div></section>
<section class="home-section"><div class="section-heading"><div><span class="section-eyebrow">探索知识体系</span><h2>九大研究领域</h2><p>从基础测序到组学分析，按研究问题查找方法。</p></div><a href={`${base}topics/`}>查看全部领域 <span aria-hidden="true">↗</span></a></div><div class="domain-grid">{domains.map(([id,slug,title,summary],i)=><a class="domain-card" href={`${base}topics/${slug}/`}><div class="domain-card-top"><span class="domain-icon"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true">{i%3===0?<><path d="M4 19c4-1 5-5 8-8s5-4 8-5M6 5c1 5 5 7 8 7M10 20c0-4 2-7 6-8"/><circle cx="5" cy="5" r="1.5"/><circle cx="19" cy="6" r="1.5"/></>:i%3===1?<><path d="M5 4c0 7 14 9 14 16M19 4C19 11 5 13 5 20M7 7h10M8 12h8M7 17h10"/></>:<><circle cx="6" cy="7" r="2"/><circle cx="18" cy="6" r="2"/><circle cx="12" cy="18" r="2"/><path d="m8 7 8-1M7 9l4 7m6-8-4 8"/></>}</svg></span><span class="domain-id">{id}</span></div><h3>{title}</h3><p>{summary}</p><span class="domain-link">进入领域 <span aria-hidden="true">→</span></span></a>)}</div></section>
<section class="home-section"><div class="section-heading"><div><span class="section-eyebrow">方法资源</span><h2>精选算法与工具</h2><p>了解工具原理、适用数据与研究实践。</p></div><a href={`${base}methods/`}>浏览全部工具 ↗</a></div><div class="method-list">{latest(methods).map((e,i)=><a href={`${base}methods/${e.id}/`} class="method-row"><span class="method-number">0{i+1}</span><span><strong>{e.data.name}</strong><small>{e.data.dataType}</small></span><span class="method-summary">{e.data.summary}</span><span class="row-arrow">↗</span></a>)}</div></section>
<section class="home-section home-updates"><div class="section-heading"><div><span class="section-eyebrow">持续更新</span><h2>最新内容与文献</h2><p>浏览专题、方法论文和分析教程。</p></div></div><div class="updates-grid"><div class="update-block"><h3>专题文章 <a href={`${base}topics/`}>全部专题 ↗</a></h3>{latest(topics).map(e=><a class="update-row" href={`${base}topics/${e.data.domain}/${e.id}/`}><span>{e.data.title}</span><time>{e.data.updatedAt.toISOString().slice(0,10)}</time></a>)}</div><div class="update-block"><h3>文献与教程 <a href={`${base}papers/`}>文献索引 ↗</a></h3>{latest(papers).map(e=><a class="update-row" href={`${base}papers/${e.id}/`}><span>{e.data.title}</span><time>{e.data.year}</time></a>)}{latest(tutorials).map(e=><a class="update-row" href={`${base}tutorials/${e.id}/`}><span>{e.data.title}</span><time>教程</time></a>)}</div></div></section></Base>
<style>
:global(main.home-main){padding-top:24px}.hero{background:#17324d;color:white;border-radius:16px;padding:56px 64px;display:grid;grid-template-columns:minmax(0,1fr) 300px;gap:40px;overflow:hidden}.hero h1{font-size:clamp(2.6rem,5vw,4.3rem);color:white;letter-spacing:-.05em;margin:16px 0 10px}.hero h2{font-size:clamp(1.15rem,2vw,1.55rem);color:#e6f3f1;margin:0 0 16px;font-weight:600}.hero p{color:#bcd0dc;font-size:1rem;margin-bottom:28px}.hero-kicker{font-size:.8rem;color:#a5d5c7;letter-spacing:.06em}.hero-line{display:inline-block;width:26px;height:2px;vertical-align:middle;background:#78b8a7;margin-right:8px}.hero-search{display:flex;align-items:center;gap:12px;background:white;border-radius:10px;padding:6px 6px 6px 18px;max-width:640px;color:#6b8190}.hero-search:focus-within{outline:3px solid #8dc7b9}.hero-search input{flex:1;border:0;outline:0;min-width:0;padding:12px 0}.hero-search button{background:#197b73;color:white;border:0;padding:11px 24px;font-weight:700}.hero-hints{display:flex;align-items:center;gap:16px;margin-top:15px;color:#a8bfcc;font-size:.8rem;flex-wrap:wrap}.hero-hints a{color:#d1eae3;text-decoration:none}.hero-aside{border-left:1px solid #426077;padding-left:32px;display:flex;flex-direction:column;justify-content:center;color:#d4ebe5;font-size:.9rem}.hero-aside svg{width:100%;height:auto}.hero-aside span{border-top:1px solid #436174;padding-top:16px}.hero-aside small{color:#93b3bd}.home-section{margin-top:72px}.section-heading{display:flex;justify-content:space-between;align-items:end;gap:24px;margin-bottom:24px}.section-heading h2{font-size:1.75rem;margin:4px 0 8px}.section-heading p{margin:0;color:var(--muted);font-size:.92rem}.section-heading>a{white-space:nowrap;text-decoration:none;font-size:.85rem;font-weight:650}.section-eyebrow{color:var(--teal);font-size:.78rem;font-weight:700}.domain-grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:16px}.domain-card{background:#fff;border:1px solid var(--border);border-radius:12px;padding:24px;text-decoration:none;color:var(--ink);min-height:205px;display:flex;flex-direction:column;transition:border-color .15s,transform .15s}.domain-card:hover{border-color:#83b9ae;transform:translateY(-2px)}.domain-card-top{display:flex;align-items:center;justify-content:space-between}.domain-icon{width:40px;height:40px;display:grid;place-items:center;background:#edf6f4;color:var(--teal);border-radius:9px}.domain-icon svg{width:24px}.domain-id{font-size:.75rem;font-weight:700;color:#8193a0;letter-spacing:.06em}.domain-card h3{font-size:1.08rem;margin:18px 0 6px}.domain-card p{font-size:.88rem;color:var(--muted);margin:0 0 16px}.domain-link{margin-top:auto;font-size:.82rem;color:var(--teal);font-weight:700}.method-list{background:#fff;border:1px solid var(--border);border-radius:12px;padding:0 24px}.method-row{display:grid;grid-template-columns:42px 200px 1fr 24px;align-items:center;gap:16px;padding:20px 0;text-decoration:none;color:var(--ink);border-bottom:1px solid var(--border)}.method-row:last-child{border:0}.method-number{color:#9aabb6;font-size:.8rem}.method-row strong{display:block;color:var(--navy);font-size:1.08rem}.method-row small{display:block;color:var(--muted);font-size:.76rem}.method-summary{color:#647789;font-size:.88rem}.row-arrow{color:var(--teal)}.updates-grid{display:grid;grid-template-columns:1fr 1fr;gap:48px;border-top:1px solid var(--border)}.update-block h3{font-size:1rem;display:flex;justify-content:space-between;align-items:center;margin:22px 0 8px}.update-block h3 a{font-size:.78rem;text-decoration:none}.update-row{display:flex;justify-content:space-between;gap:16px;color:var(--ink);text-decoration:none;border-bottom:1px solid var(--border);padding:14px 0;font-size:.9rem}.update-row:hover{color:var(--teal)}.update-row time{color:#91a0aa;white-space:nowrap;font-size:.78rem}.sr-only{position:absolute;width:1px;height:1px;overflow:hidden;clip:rect(0,0,0,0)}@media(max-width:900px){.hero{grid-template-columns:1fr;padding:40px}.hero-aside{display:none}.domain-grid{grid-template-columns:repeat(2,minmax(0,1fr))}}@media(max-width:600px){:global(main.home-main){padding-top:12px}.hero{padding:32px 24px;border-radius:12px}.hero h1{font-size:2.6rem}.hero-search button{padding:10px 14px}.domain-grid,.updates-grid{grid-template-columns:1fr}.home-section{margin-top:48px}.section-heading{align-items:start}.section-heading>a{font-size:.76rem}.domain-card{min-height:170px}.method-row{grid-template-columns:25px 1fr 20px}.method-summary{grid-column:2/3}.updates-grid{gap:8px}}
</style>
