---
import {topicMetadata} from '../data/topics';import {domains} from '../data/domains';
const { headings = [], current = '', domain = 'genome-assembly' } = Astro.props;
const base=import.meta.env.BASE_URL;
const sections=topicMetadata.filter(t=>t.domainId===domain && t.status==='published').sort((a,b)=>a.order-b.order).map(t=>[t.id,t.title]);const domainTitle=domains.find(d=>d[1]===domain)?.[2] ?? '研究领域';
---
<div class="reading-layout"><aside class="side" aria-label="研究领域与专题目录"><details open><summary>研究领域</summary><a class="side-root" href={`${base}topics/${domain}/`}>{domainTitle}</a><ul>{sections.map(([id,title])=><li><a aria-current={id===current?'page':undefined} href={`${base}topics/${domain}/${id}/`}>{title}</a></li>)}</ul><p><a href={`${base}methods/`}>算法与工具</a>　<a href={`${base}papers/`}>文献</a></p></details></aside><div class="reading-main"><slot/></div><aside class="side toc" aria-label="本页章节目录"><details open><summary>本页内容</summary><ul>{headings.filter((h:{depth:number})=>h.depth===2).map((h:{slug:string,text:string})=><li><a href={`#${h.slug}`}>{h.text}</a></li>)}</ul></details></aside></div>
<script>
if(matchMedia('(max-width: 900px)').matches)document.querySelectorAll('.side details').forEach(d=>d.removeAttribute('open'));const links=[...document.querySelectorAll<HTMLAnchorElement>('.toc a')];const targets=links.map(a=>document.getElementById(decodeURIComponent(a.hash.slice(1)))).filter((e):e is HTMLElement=>!!e);if('IntersectionObserver'in window){const observer=new IntersectionObserver(entries=>{for(const e of entries)if(e.isIntersecting)links.forEach(a=>a.classList.toggle('active',decodeURIComponent(a.hash.slice(1))===e.target.id))},{rootMargin:'-10% 0px -75% 0px'});targets.forEach(t=>observer.observe(t))}
</script>
<style>.reading-layout{display:grid;grid-template-columns:220px minmax(0,780px) 190px;gap:40px;align-items:start;justify-content:space-between;margin-top:40px}.side{position:sticky;top:24px;font-size:.83rem;color:var(--muted)}.side summary{font-weight:750;color:var(--navy);cursor:pointer;list-style:none;border-bottom:1px solid var(--border);padding:0 0 12px}.side summary::-webkit-details-marker{display:none}.side-root{display:block;margin:16px 0 8px;font-weight:700}.side ul{list-style:none;margin:12px 0;padding:0}.side li{margin:3px 0}.side li a{display:block;color:#617282;text-decoration:none;border-left:2px solid transparent;padding:6px 10px}.side a[aria-current=page],.side a.active{background:#e8f3f1;border-left-color:var(--teal);color:var(--teal);font-weight:700}.side p{margin-top:24px}.reading-main{min-width:0;background:white;border:1px solid var(--border);border-radius:12px;padding:40px 48px}.reading-main :global(p){line-height:1.95;margin:0 0 1.25em}.reading-main :global(h2){font-size:1.42rem;margin:2.2em 0 .8em;padding-top:.2em}.reading-main :global(h2:first-child){margin-top:0}.reading-main :global(h3){font-size:1.1rem;margin:1.7em 0 .6em}.reading-main :global(table){display:block;max-width:100%;overflow-x:auto}.reading-main :global(.katex-display){overflow-x:auto;overflow-y:hidden}.reading-main :global(nav){border-top:1px solid var(--border);padding-top:24px;display:flex;gap:20px;flex-wrap:wrap}.reading-main :global(li){margin:.35em 0}@media(max-width:1100px){.reading-layout{gap:24px;grid-template-columns:185px minmax(0,1fr) 155px}.reading-main{padding:32px}}@media(max-width:900px){.reading-layout{display:flex;flex-direction:column;gap:12px;margin-top:24px}.side{position:static;width:100%;background:#fff;border:1px solid var(--border);border-radius:8px;padding:14px 16px}.side summary{border:0;padding:0}.side summary:after{content:'＋';float:right;color:var(--teal)}.side details[open] summary:after{content:'−'}.reading-main{width:100%;order:2;padding:24px 20px}.toc{order:1}}</style>
