---
const { headings = [], current = '' } = Astro.props;
const base=import.meta.env.BASE_URL;
const sections=[['sequencing-data','测序技术与原始数据'],['assembly-basics','基因组组装基础'],['hic-scaffolding','Hi-C 辅助染色体挂载'],['complete-assembly','T2T 与复杂区域组装'],['assembly-graphs','组装图与核心算法'],['haplotype-resolution','单倍型解析'],['assembly-quality','组装质量评估']];
---
<div class="reading-layout"><aside class="side"><details open><summary>领域知识目录</summary><p><a href={`${base}topics/genome-assembly/`}>测序与基因组组装</a></p><ul>{sections.map(([id,title])=><li><a aria-current={id===current?'page':undefined} href={`${base}topics/genome-assembly/${id}/`}>{title}</a></li>)}</ul><p><a href={`${base}methods/`}>算法与工具</a> · <a href={`${base}papers/`}>文献</a></p></details></aside><div class="reading-main"><slot/></div><aside class="side toc"><details open><summary>本页目录</summary><ul>{headings.filter((h:{depth:number})=>h.depth===2).map((h:{slug:string,text:string})=><li><a href={`#${h.slug}`}>{h.text}</a></li>)}</ul></details></aside></div>
<script>
if(matchMedia('(max-width: 900px)').matches) document.querySelectorAll('.side details').forEach(d=>d.removeAttribute('open'));
const links=[...document.querySelectorAll<HTMLAnchorElement>('.toc a')];
const targets=links.map(a=>document.getElementById(decodeURIComponent(a.hash.slice(1)))).filter((e):e is HTMLElement=>!!e);
if('IntersectionObserver' in window){const observer=new IntersectionObserver(entries=>{for(const e of entries)if(e.isIntersecting)links.forEach(a=>a.classList.toggle('active',decodeURIComponent(a.hash.slice(1))===e.target.id));},{rootMargin:'-10% 0px -75% 0px'});targets.forEach(t=>observer.observe(t));}
</script>
<style>.reading-layout{display:grid;grid-template-columns:190px minmax(0,1fr) 180px;gap:28px;align-items:start}.side{position:sticky;top:1rem;font-size:.9rem}.side ul{padding-left:1.1rem}.side a[aria-current=page],.side a.active{font-weight:700;color:#153b54;text-decoration-thickness:3px}.reading-main{min-width:0}.reading-main :global(p){line-height:1.85}.reading-main :global(h2){margin-top:2em}.reading-main :global(table){display:block;max-width:100%;overflow-x:auto}.reading-main :global(.katex-display){overflow-x:auto;overflow-y:hidden}@media(max-width:900px){.reading-layout{display:flex;flex-direction:column}.side{position:static;width:100%}.reading-main{width:100%;order:2}.toc{order:1}}</style>
