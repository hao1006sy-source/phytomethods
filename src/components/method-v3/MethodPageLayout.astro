---
import { createMarkdownProcessor } from '@astrojs/markdown-remark';
import remarkMath from 'remark-math';
import rehypeKatex from 'rehype-katex';
import { domains as domainDirectory } from '../../data/domains';
import { topicMetadata } from '../../data/topics';
import MethodHeader from './MethodHeader.astro';
import MethodSidebar from './MethodSidebar.astro';
import MethodResources from './MethodResources.astro';
import MethodFigureRegistry from './MethodFigureRegistry.astro';
import MethodComputeProfile from '../MethodComputeProfile.astro';
import MethodTroubleshooting from '../MethodTroubleshooting.astro';
import ContentFeedback from '../ContentFeedback.astro';
import { splitMethodMarkdown } from './config/method-sections';
import './method-v3.css';
import './method-generic.css';

const { entry, papers, tutorials, methods } = Astro.props;
const base = import.meta.env.BASE_URL;
const methodId = entry.id as string;
const methodDomains = entry.data.domainIds.map((id: string) => domainDirectory.find(domain => domain[1] === id)).filter(Boolean);
const paper = papers.find((item: any) => item.id === entry.data.paper);
const applications = papers.filter((item: any) => item.data.type === 'application' && item.data.methodIds.includes(methodId));
const tutorial = tutorials.find((item: any) => item.data.method === methodId);
const relatedTopics = topicMetadata.filter(topic => topic.status === 'published' && topic.methodIds.includes(methodId));
const sections = splitMethodMarkdown(entry.body ?? '');
const processor = await createMarkdownProcessor({ remarkPlugins: [remarkMath], rehypePlugins: [rehypeKatex] });
const renderedSections = await Promise.all(sections.map(async section => ({
  ...section,
  html: (await processor.render(section.markdown)).code,
})));

if (!renderedSections.length) throw new Error(`Method V3: ${methodId} has no Markdown body`);
if (renderedSections.some(section => !section.id || !section.title)) throw new Error(`Method V3: ${methodId} has a heading without a stable navigation id`);
---
<div class="method-v3 method-generic" data-method-id={methodId}>
  <MethodHeader entry={entry} domain={methodDomains} paper={paper} />
  <div class="method-columns">
    <MethodSidebar sections={renderedSections} />
    <article class="method-main" aria-label={`${entry.data.name} 算法文档`}>
      <section class="method-section method-overview" id="method-overview">
        <h2>算法概览</h2>
        <p>{entry.data.summary}</p>
      </section>
      {renderedSections.map((section, index) => (
        <section class="method-section method-original-section" id={`method-${section.id}`} data-source-heading={section.title}>
          <h2>{section.title}</h2>
          <div class="method-source prose" set:html={section.html} />
          {(methodId === 'verkko' && /流程|算法|计算/.test(section.title) && index === renderedSections.findIndex(item => /流程|算法|计算/.test(item.title))) && <MethodFigureRegistry methodId={methodId} />}
          {(methodId === 'merqury' && /频谱|输出|计算/.test(section.title) && index === renderedSections.findIndex(item => /频谱|输出|计算/.test(item.title))) && <MethodFigureRegistry methodId={methodId} />}
        </section>
      ))}
      <MethodComputeProfile methodId={methodId} />
      <MethodTroubleshooting methodId={methodId} />
      <section class="method-section method-related-section" id="method-related">
        <h2>站内关联</h2>
        <div class="method-related-links">
          {relatedTopics.map(topic => <a href={`${base}topics/${topic.domainId}/${topic.id}/`}>{topic.title}</a>)}
          {applications.map((application: any) => <a href={`${base}papers/${application.id}/`}>{application.data.title}</a>)}
          {tutorial && <a href={`${base}tutorials/${tutorial.id}/`}>{tutorial.data.title}</a>}
          {relatedTopics.flatMap(topic => topic.methodIds).filter((id, index, ids) => id !== methodId && ids.indexOf(id) === index).slice(0, 6).map(id => {
            const related = methods.find((item: any) => item.id === id);
            return related && <a href={`${base}methods/${related.id}/`}>{related.data.name}</a>;
          })}
        </div>
      </section>
      <div style="margin-top: 2rem;">
        <ContentFeedback pageTitle={`${entry.data.name} 算法与工具`} sourcePath={`src/content/methods/${entry.id}.md`} />
      </div>
    </article>
    <MethodResources paper={paper} applications={applications} entry={entry} tutorial={tutorial} methods={methods} relatedTopics={relatedTopics} />
  </div>
</div>
