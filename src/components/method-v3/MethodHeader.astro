---
const {entry,domain,paper,outputSummary}=Astro.props;
const base=import.meta.env.BASE_URL;
const domains=Array.isArray(domain?.[0])?domain:(domain?[domain]:[]);
---
<header class="method-header"><p class="method-crumb"><a href={base}>首页</a><span>/</span><a href={`${base}methods/`}>算法与工具</a><span>/</span>{entry.data.name}</p><div class="method-heading"><h1>{entry.data.name}</h1><div class="method-tags">{domains.map((d:any)=><a href={`${base}topics/${d[1]}/`}>{d[2]} · {d[0]}</a>)}<span>{entry.data.dataType}</span><span>{entry.data.principle}</span></div></div><p class="method-summary">{entry.data.summary}</p><div class="method-header-bottom"><dl class="method-facts"><div><dt>输入数据</dt><dd>{entry.data.dataType}</dd></div><div><dt>核心计算方法</dt><dd>{entry.data.principle}</dd></div>{outputSummary&&<div><dt>主要输出</dt><dd>{outputSummary}</dd></div>}</dl><div class="method-actions">{paper&&<a class="method-primary" href={`${base}papers/${paper.id}/`}>查看方法论文 ↗</a>}<a href={entry.data.repository} target="_blank" rel="noreferrer">查看官方代码 ↗</a></div></div></header>
