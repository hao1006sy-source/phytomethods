---
import { methodComputeProfiles } from '../data/method-compute-profiles';

interface Props {
  methodId: string;
}

const { methodId } = Astro.props;
const profile = methodComputeProfiles[methodId];
---

<section class="method-compute-profile-card" id="method-compute-profile" aria-label="计算资源与运行规模基准">
  <div class="compute-card-header">
    <div class="compute-tag-row">
      <span class="compute-tag">COMPUTE PROFILE</span>
      <span class={`status-badge ${profile?.hasBenchmark ? (profile.benchmarkType === 'empirical_log' ? 'is-empirical' : 'has-data') : 'no-data'}`}>
        {profile?.hasBenchmark
          ? (profile.benchmarkType === 'empirical_log' ? '✓ 本站实测日志基准' : '✓ 权威文献/官方基准')
          : '暂无可核实基准'}
      </span>
      {profile?.verifiedDate && (
        <span class="verify-date-pill">核查日期：{profile.verifiedDate}</span>
      )}
    </div>
    <h3 class="compute-card-title">计算资源与硬件耗时评估</h3>
  </div>

  {profile && profile.hasBenchmark ? (
    <div class="compute-card-body">
      <!-- 场景与硬件基准表格 -->
      <div class="profile-grid">
        <div class="grid-item">
          <span class="item-label">基准测试数据场景</span>
          <span class="item-val">{profile.scenario}</span>
        </div>
        <div class="grid-item">
          <span class="item-label">测试目标版本与对象</span>
          <span class="item-val font-mono">{profile.softwareVersion ?? '稳定版'} · {profile.datasetOrSpecies ?? '植物基因组'}</span>
        </div>
        <div class="grid-item">
          <span class="item-label">基准硬件测试环境</span>
          <span class="item-val font-mono">{profile.hardware}</span>
        </div>
        <div class="grid-item">
          <span class="item-label">输入数据规模</span>
          <span class="item-val">{profile.inputScale ?? '标准规模测试集'}</span>
        </div>
        <div class="grid-item highlight-memory">
          <span class="item-label">峰值内存需求 (Peak RAM)</span>
          <span class="item-val font-bold">{profile.peakMemory}</span>
        </div>
        <div class="grid-item highlight-runtime">
          <span class="item-label">参考运行耗时 (Runtime)</span>
          <span class="item-val font-bold">{profile.runtime}</span>
        </div>
      </div>

      <!-- 多线程与扩展性分析 -->
      <div class="scalability-box">
        <div class="sub-item">
          <strong>多核 CPU 并发扩展性：</strong>
          <span>{profile.cpuScalability}</span>
        </div>
        {profile.scalingFormula && (
          <div class="sub-item">
            <strong>规模扩展趋势与复杂度：</strong>
            <span>{profile.scalingFormula}</span>
          </div>
        )}
      </div>

      <!-- 调优与避坑建议 -->
      {profile.bottleneckTips && (
        <div class="tips-box">
          <span class="tips-icon">💡</span>
          <div class="tips-content">
            <strong>资源规划与调优建议：</strong>
            <span>{profile.bottleneckTips}</span>
          </div>
        </div>
      )}

      <!-- 数据证据来源 -->
      {profile.evidenceSource && (
        <div class="evidence-footer">
          <span class="evidence-label">数据与证据来源：</span>
          <span class="evidence-source">{profile.evidenceSource}</span>
          {profile.benchmarkSectionOrTable && (
            <span class="evidence-detail">({profile.benchmarkSectionOrTable})</span>
          )}
        </div>
      )}
    </div>
  ) : (
    <div class="no-benchmark-box">
      <p class="no-data-msg">
        本方法目前尚未在植物大规模数据集上建立标准化的独立资源基准测试档案。
      </p>
      <p class="no-data-sub">
        实际分析中，建议先采用 16 线程、32 GB 内存并监控 <code>htop</code> 资源占用，再根据样本数据规模调整作业调度脚本。
      </p>
    </div>
  )}
</section>

<style>
  .method-compute-profile-card {
    margin: 2rem 0;
    padding: 1.5rem;
    background: var(--color-surface, #ffffff);
    border: 1px solid var(--color-border, #e2e8f0);
    border-radius: 12px;
    box-shadow: 0 2px 8px rgba(0, 0, 0, 0.03);
  }

  .compute-card-header {
    margin-bottom: 1.25rem;
  }

  .compute-tag-row {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.5rem;
    margin-bottom: 0.35rem;
  }

  .compute-tag {
    font-size: 0.75rem;
    font-weight: 700;
    color: #0284c7;
    background: #e0f2fe;
    padding: 0.2rem 0.55rem;
    border-radius: 9999px;
    letter-spacing: 0.05em;
  }

  :global(.dark) .compute-tag {
    background: #0369a133;
    color: #38bdf8;
  }

  .status-badge {
    font-size: 0.75rem;
    font-weight: 600;
    padding: 0.2rem 0.55rem;
    border-radius: 9999px;
  }

  .status-badge.has-data {
    background: #dcfce7;
    color: #15803d;
  }

  .status-badge.is-empirical {
    background: #fef3c7;
    color: #b45309;
  }

  :global(.dark) .status-badge.has-data {
    background: #14532d33;
    color: #4ade80;
  }

  :global(.dark) .status-badge.is-empirical {
    background: #78350f33;
    color: #fcd34d;
  }

  .status-badge.no-data {
    background: #f1f5f9;
    color: #64748b;
  }

  :global(.dark) .status-badge.no-data {
    background: #1e293b;
    color: #94a3b8;
  }

  .verify-date-pill {
    font-size: 0.72rem;
    color: #64748b;
    background: #f8fafc;
    border: 1px solid #e2e8f0;
    padding: 0.15rem 0.45rem;
    border-radius: 6px;
  }

  :global(.dark) .verify-date-pill {
    background: #1e293b;
    border-color: #334155;
    color: #94a3b8;
  }

  .compute-card-title {
    font-size: 1.15rem;
    font-weight: 700;
    color: var(--color-text-main, #0f172a);
    margin: 0.25rem 0 0;
  }

  .profile-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 1rem;
    margin-bottom: 1.25rem;
  }

  @media (max-width: 640px) {
    .profile-grid {
      grid-template-columns: 1fr;
    }
  }

  .grid-item {
    padding: 0.85rem 1rem;
    background: var(--color-bg-alt, #f8fafc);
    border-radius: 8px;
    border: 1px solid var(--color-border, #f1f5f9);
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
  }

  .grid-item.highlight-memory {
    border-left: 3px solid #0284c7;
  }

  .grid-item.highlight-runtime {
    border-left: 3px solid #16a34a;
  }

  .item-label {
    font-size: 0.75rem;
    color: #64748b;
    font-weight: 600;
  }

  :global(.dark) .item-label {
    color: #94a3b8;
  }

  .item-val {
    font-size: 0.9rem;
    color: var(--color-text-main, #1e293b);
  }

  .font-mono {
    font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace;
    font-size: 0.82rem;
  }

  .font-bold {
    font-weight: 700;
    color: var(--color-text-main, #0f172a);
  }

  .scalability-box {
    padding: 0.85rem 1rem;
    background: var(--color-bg-alt, #f8fafc);
    border-radius: 8px;
    margin-bottom: 1rem;
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    font-size: 0.88rem;
    color: var(--color-text-muted, #334155);
  }

  .tips-box {
    display: flex;
    gap: 0.75rem;
    padding: 0.85rem 1rem;
    background: #fefce8;
    border: 1px solid #fef08a;
    border-radius: 8px;
    margin-bottom: 1rem;
    font-size: 0.88rem;
    color: #854d0e;
  }

  :global(.dark) .tips-box {
    background: #42200633;
    border-color: #854d0e55;
    color: #fde047;
  }

  .evidence-footer {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.4rem;
    font-size: 0.78rem;
    color: #64748b;
    padding-top: 0.75rem;
    border-top: 1px solid var(--color-border, #e2e8f0);
  }

  .evidence-label {
    font-weight: 600;
  }

  .evidence-source {
    font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace;
  }

  .evidence-detail {
    color: #94a3b8;
  }

  .no-benchmark-box {
    padding: 1.5rem;
    background: var(--color-bg-alt, #f8fafc);
    border-radius: 8px;
    text-align: center;
  }

  .no-data-msg {
    color: #64748b;
    font-size: 0.95rem;
    margin-bottom: 0.5rem;
  }

  .no-data-sub {
    color: #94a3b8;
    font-size: 0.85rem;
  }
</style>
