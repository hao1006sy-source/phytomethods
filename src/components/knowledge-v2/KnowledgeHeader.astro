---
interface Props {
  totalNodes: number;
  totalEdges: number;
  totalEvidence: number;
}

const { totalNodes, totalEdges, totalEvidence } = Astro.props;
---

<div class="knowledge-top-bar">
  <div class="top-bar-left">
    <h1 class="top-bar-title">科研知识关联图</h1>
    <span class="top-bar-subtitle">Scientific Knowledge Explorer</span>
  </div>
  <div class="top-bar-right">
    <div class="stat-pill">
      <span>全局图谱:</span>
      <strong id="stat-total-nodes">{totalNodes}</strong> 节点 /
      <strong id="stat-total-edges">{totalEdges}</strong> 关系 /
      <strong>{totalEvidence}</strong> 证据
    </div>
    <div class="stat-pill stat-pill-accent">
      <span>当前视图:</span>
      <strong id="stat-view-nodes">--</strong> 节点 /
      <strong id="stat-view-edges">--</strong> 关系
    </div>
  </div>
</div>
