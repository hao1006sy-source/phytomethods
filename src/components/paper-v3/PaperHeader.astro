---
import { paperTypeBadgeMap } from './config/paper-types';
import { domains } from '../../data/domains';
import { speciesLabels } from '../../data/tags';

interface Props {
  paper: {
    id: string;
    title: string;
    authors: string;
    journal: string;
    year: number | string;
    doi: string;
    type: 'method' | 'application' | 'review';
    volumePages?: string;
    fullAuthors?: string;
    domainIds?: string[];
    speciesIds?: string[];
    methodIds?: string[];
  };
}

const { paper } = Astro.props;
const base = import.meta.env.BASE_URL;

const badgeText = paperTypeBadgeMap[paper.type] || '科研文献';
const doiUrl = `https://doi.org/${paper.doi}`;

// 动态生成关键词标签云
const tags: string[] = [];
// 1. 研究领域
if (paper.domainIds) {
  for (const dId of paper.domainIds) {
    const found = domains.find(d => d[1] === dId);
    if (found) tags.push(found[2]);
  }
}
// 2. 物种信息
if (paper.speciesIds) {
  for (const sId of paper.speciesIds) {
    const found = speciesLabels[sId];
    if (found) tags.push(found.split(/\s+/)[0]);
  }
}
// 3. 关联方法工具名
if (paper.methodIds) {
  for (const mId of paper.methodIds) {
    tags.push(mId.toUpperCase());
  }
}
// 4. 类型补充标签
if (paper.type === 'method') tags.push('算法模型');
else if (paper.type === 'application') tags.push('植物案例');
else if (paper.type === 'review') tags.push('系统综述');

// 去重并限制数量
const uniqueTags = [...new Set(tags)].slice(0, 5);
const storageKey = `pm_fav_paper_${paper.id}`;
---

<header id="paper-info" class="paper-header">
  <nav class="paper-crumb" aria-label="文献路径导航">
    <a href={base}>首页</a>
    <span aria-hidden="true">/</span>
    <a href={`${base}papers/`}>文献索引</a>
    <span aria-hidden="true">/</span>
    <span aria-current="page">文献详情</span>
  </nav>

  <div class="paper-header-main">
    <div class="paper-badge-wrap">
      <span class="paper-badge" data-paper-type={paper.type}>{badgeText}</span>
    </div>

    <h1 class="paper-title">{paper.title}</h1>

    <div class="paper-meta-row">
      <span class="authors" title={paper.fullAuthors || paper.authors}>
        {paper.authors}
      </span>
      <span class="journal-info">
        {paper.journal} · {paper.year}{paper.volumePages ? ` · ${paper.volumePages}` : ''}
      </span>
      <a href={doiUrl} target="_blank" rel="noreferrer" class="doi-link">
        DOI: {paper.doi} <span aria-hidden="true">↗</span>
      </a>
    </div>

    <div class="paper-actions-bar">
      <div class="paper-tags" aria-label="研究关键词">
        {uniqueTags.map(tag => (
          <span class="paper-tag">{tag}</span>
        ))}
      </div>

      <div class="paper-buttons">
        <button type="button" id="open-citation-btn" class="paper-btn" aria-haspopup="dialog">
          <span aria-hidden="true">❝</span> 引用
        </button>
        <button
          type="button"
          id="favorite-btn"
          class="paper-btn"
          data-storage-key={storageKey}
          aria-label="收藏该文献"
        >
          <span id="favorite-icon" aria-hidden="true">☆</span> <span id="favorite-text">收藏</span>
        </button>
        <a href={doiUrl} target="_blank" rel="noreferrer" class="paper-btn paper-btn-primary">
          阅读原文 <span aria-hidden="true">↗</span>
        </a>
      </div>
    </div>
  </div>
</header>

<script>
  // 引用弹窗与动态收藏交互
  const citeBtn = document.getElementById('open-citation-btn');
  const dialog = document.getElementById('citation-dialog') as HTMLDialogElement | null;
  const favBtn = document.getElementById('favorite-btn') as HTMLButtonElement | null;
  const favIcon = document.getElementById('favorite-icon');
  const favText = document.getElementById('favorite-text');

  citeBtn?.addEventListener('click', () => {
    dialog?.showModal();
  });

  if (favBtn) {
    const storageKey = favBtn.dataset.storageKey || 'pm_fav_paper';
    try {
      const isFav = localStorage.getItem(storageKey) === 'true';
      if (isFav && favIcon && favText) {
        favIcon.textContent = '★';
        favText.textContent = '已收藏';
        favBtn.classList.add('is-active');
      }

      favBtn.addEventListener('click', () => {
        const currentlyFav = localStorage.getItem(storageKey) === 'true';
        if (currentlyFav) {
          localStorage.removeItem(storageKey);
          if (favIcon) favIcon.textContent = '☆';
          if (favText) favText.textContent = '收藏';
          favBtn.classList.remove('is-active');
        } else {
          localStorage.setItem(storageKey, 'true');
          if (favIcon) favIcon.textContent = '★';
          if (favText) favText.textContent = '已收藏';
          favBtn.classList.add('is-active');
        }
      });
    } catch (_) {
      // 在无 localStorage 权限环境下优雅降级，允许点击切换状态
      favBtn.addEventListener('click', () => {
        favBtn.classList.toggle('is-active');
      });
    }
  }
</script>
