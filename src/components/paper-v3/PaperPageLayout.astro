---
import { paperTypeBadgeMap, type PaperSection } from './config/paper-types';
import { generateCitations } from './config/citation-helper';
import { hifiasmCustomData } from './config/hifiasm-custom';
import PaperHeader from './PaperHeader.astro';
import PaperSidebar from './PaperSidebar.astro';
import PaperHighlights from './PaperHighlights.astro';
import PaperResources from './PaperResources.astro';
import PaperFigureRegistry from './PaperFigureRegistry.astro';
import PaperNotes from './PaperNotes.astro';
import CitationModal from './CitationModal.astro';
import { topicMetadata } from '../../data/topics';
import './paper-v3.css';

interface Props {
  entry: any;
  headings: any[];
  allMethods?: any[];
  allPapers?: any[];
  allTutorials?: any[];
}

const {
  entry,
  headings = [],
  allMethods = [],
  allPapers = [],
  allTutorials = []
} = Astro.props;

const base = import.meta.env.BASE_URL;
const isHifiasm = entry.id === 'hifiasm';

// 1. 合并补充元数据
const paperMeta = {
  id: entry.id,
  title: entry.data.title,
  summary: entry.data.summary,
  authors: isHifiasm ? hifiasmCustomData.shortAuthors : entry.data.authors,
  fullAuthors: isHifiasm ? hifiasmCustomData.fullAuthors : entry.data.authors,
  journal: entry.data.journal,
  year: entry.data.year,
  doi: entry.data.doi,
  type: entry.data.type,
  volumePages: isHifiasm ? hifiasmCustomData.volumePages : undefined,
  domainIds: entry.data.domainIds || [],
  speciesIds: entry.data.speciesIds || [],
  methodIds: entry.data.methodIds || []
};

// 2. 动态生成引用文本
const citations = generateCitations(paperMeta);

// 3. 动态关联真实资源
const relatedMethods = allMethods.filter(m => paperMeta.methodIds.includes(m.id));
const relatedTopics = topicMetadata.filter(t => 
  t.status === 'published' && (
    t.paperIds.includes(entry.id) ||
    t.methodIds.some(mId => paperMeta.methodIds.includes(mId))
  )
);
const relatedTutorials = allTutorials.filter(tut =>
  paperMeta.methodIds.includes(tut.data.method)
);

// 查找关联的植物应用案例（用于 method 论文）
let plantApplicationPaper: any = null;
if (entry.data.type === 'method') {
  if (isHifiasm) {
    plantApplicationPaper = allPapers.find(p => p.id === 'macadamia');
  } else {
    plantApplicationPaper = allPapers.find(p => 
      p.id !== entry.id &&
      p.data.type === 'application' &&
      p.data.methodIds.includes(entry.id) &&
      p.data.speciesIds.length > 0
    );
  }
}

// 推荐相关文献（同领域或同工具）
const relatedPapers = allPapers.filter(p =>
  p.id !== entry.id &&
  p.data.status === 'published' &&
  (
    (p.data.methodIds.length > 0 && p.data.methodIds.some((m: string) => paperMeta.methodIds.includes(m))) ||
    (p.data.domainIds.some((d: string) => paperMeta.domainIds.includes(d)))
  )
).slice(0, 2);

// 4. 动态构建文章目录 sections
const numberSymbols = ['①', '②', '③', '④', '⑤', '⑥', '⑦', '⑧', '⑨', '⑩', '⑪', '⑫'];
const sections: PaperSection[] = [];

// 顶层必备节点
sections.push({
  id: 'paper-info',
  number: numberSymbols[0],
  title: '核心信息'
});

const highlightTitle = entry.data.type === 'method' ? '核心贡献' : entry.data.type === 'application' ? '研究发现' : '综述要点';
sections.push({
  id: 'paper-contributions',
  number: numberSymbols[1],
  title: highlightTitle
});

// 从 Markdown 二级标题动态生成目录项
let numIdx = 2;
const h2Headings = headings.filter((h: any) => h.depth === 2);
for (const h of h2Headings) {
  sections.push({
    id: h.slug,
    number: numberSymbols[numIdx % numberSymbols.length],
    title: h.text,
    depth: 2
  });
  numIdx++;
}

// Hifiasm 专属保留流程图导航锚点
if (isHifiasm) {
  sections.push({
    id: 'hifiasm-workflow-figure',
    number: numberSymbols[numIdx % numberSymbols.length],
    title: '算法流程图解'
  });
  numIdx++;
}

// 精读笔记节点
sections.push({
  id: 'paper-notes',
  number: numberSymbols[numIdx % numberSymbols.length],
  title: '精读笔记'
});
numIdx++;

// 相关文献推荐节点
if (relatedPapers.length > 0) {
  sections.push({
    id: 'paper-related-papers',
    number: numberSymbols[numIdx % numberSymbols.length],
    title: '相关文献'
  });
}

// 5. 前后文献翻页导航
const sortedPapers = [...allPapers].sort((a, b) => a.id.localeCompare(b.id));
const currentIndex = sortedPapers.findIndex(p => p.id === entry.id);
const prevPaper = currentIndex > 0 ? sortedPapers[currentIndex - 1] : null;
const nextPaper = currentIndex < sortedPapers.length - 1 ? sortedPapers[currentIndex + 1] : null;
---

<div class="paper-v3" data-paper-id={entry.id}>
  <!-- 顶部文献信息与操作栏 -->
  <PaperHeader paper={paperMeta} />

  <!-- 三栏核心区域 -->
  <div class="paper-columns">
    <!-- 左侧：动态目录导航 -->
    <PaperSidebar sections={sections} />

    <!-- 中间：文献核心正文 -->
    <main class="paper-main" aria-label="文献深度解读">
      <!-- 1. 核心贡献 / 研究亮点卡片 -->
      <PaperHighlights
        paperId={entry.id}
        type={entry.data.type}
        summary={entry.data.summary}
        highlights={isHifiasm ? hifiasmCustomData.highlights : []}
        customSummary={isHifiasm ? hifiasmCustomData.coreContributionSummary : undefined}
      />

      <!-- 2. Hifiasm 专属科研图解 -->
      {isHifiasm && (
        <section id="hifiasm-workflow-figure" class="paper-section">
          <h2 class="paper-section-title">
            <span aria-hidden="true">⚙️</span> 核心算法思想与流程图解
          </h2>
          <PaperFigureRegistry paperId={entry.id} />
        </section>
      )}

      <!-- 3. 完整 Markdown 正文内容 (100% 保留原生段落、公式、表格与链接) -->
      <article class="paper-prose prose" data-pagefind-body>
        <slot />
      </article>

      <!-- 4. Hifiasm 专属评测指标表格 (保持原样) -->
      {isHifiasm && (
        <section id="hifiasm-benchmarks" class="paper-section">
          <h2 class="paper-section-title">
            <span aria-hidden="true">📊</span> 关键评估结果与科学意义
          </h2>
          <div class="paper-table-wrapper">
            <table class="paper-table">
              <thead>
                <tr>
                  <th>测试数据集</th>
                  <th>基因组特性</th>
                  <th>Contig N50 (Mb)</th>
                  <th>开关错误率 (Switch Error)</th>
                  <th>计算耗时 (CPU 小时)</th>
                </tr>
              </thead>
              <tbody>
                {hifiasmCustomData.benchmarkResults.map(row => (
                  <tr>
                    <td><strong>{row.dataset}</strong></td>
                    <td>{row.features}</td>
                    <td>{row.contigN50}</td>
                    <td>{row.switchError}</td>
                    <td>{row.cpuTime}</td>
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
        </section>
      )}

      <!-- 5. 结构化精读笔记 -->
      <section id="paper-notes" class="paper-section">
        <h2 class="paper-section-title">
          <span aria-hidden="true">📝</span> 结构化精读笔记
        </h2>
        <PaperNotes paperId={entry.id} />
      </section>

      <!-- 6. 延伸阅读与相关文献 -->
      {relatedPapers.length > 0 && (
        <section id="paper-related-papers" class="paper-section">
          <h2 class="paper-section-title">
            <span aria-hidden="true">📚</span> 延伸阅读与相关文献
          </h2>
          <div class="paper-related-grid">
            {relatedPapers.map(p => (
              <a href={`${base}papers/${p.id}/`} class="paper-related-item">
                <span class="paper-related-tag">{paperTypeBadgeMap[p.data.type as keyof typeof paperTypeBadgeMap] || '科研文献'} ｜ {p.data.journal} {p.data.year}</span>
                <h3 class="paper-related-title">{p.data.title}</h3>
                <p class="paper-related-meta">{p.data.authors} ｜ {p.data.summary}</p>
              </a>
            ))}
          </div>
        </section>
      )}

      <!-- 底部翻页导航 -->
      <nav class="paper-pagination" aria-label="文献浏览导航">
        {prevPaper ? (
          <a href={`${base}papers/${prevPaper.id}/`} class="paper-nav-prev">
            ← 上一篇：{prevPaper.data.title.slice(0, 32)}...
          </a>
        ) : (
          <a href={`${base}papers/`} class="paper-nav-back">← 返回文献索引列表</a>
        )}
        {nextPaper ? (
          <a href={`${base}papers/${nextPaper.id}/`} class="paper-nav-next">
            下一篇：{nextPaper.data.title.slice(0, 32)}... →
          </a>
        ) : (
          <a href={`${base}papers/`} class="paper-nav-back">返回文献索引列表 →</a>
        )}
      </nav>
    </main>

    <!-- 右侧：文献信息、关联内容、植物应用卡片 -->
    <PaperResources
      paper={paperMeta}
      relatedMethods={relatedMethods}
      relatedTopics={relatedTopics}
      relatedTutorials={relatedTutorials}
      plantApplicationPaper={plantApplicationPaper}
    />
  </div>

  <!-- 动态引用弹窗 Modal -->
  <CitationModal
    bibtex={citations.bibtex}
    apa={citations.apa}
    gb7714={citations.gb7714}
  />
</div>
