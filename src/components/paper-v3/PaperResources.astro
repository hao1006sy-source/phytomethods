---
import { paperTypeBadgeMap } from './config/paper-types';
import { speciesLabels } from '../../data/tags';

interface Props {
  paper: {
    id: string;
    title: string;
    type: 'method' | 'application' | 'review';
    journal: string;
    year: number | string;
    doi: string;
    volumePages?: string;
    speciesIds?: string[];
    methodIds?: string[];
  };
  relatedMethods?: any[];
  relatedTopics?: any[];
  relatedTutorials?: any[];
  plantApplicationPaper?: any;
}

const {
  paper,
  relatedMethods = [],
  relatedTopics = [],
  relatedTutorials = [],
  plantApplicationPaper
} = Astro.props;

const base = import.meta.env.BASE_URL;
const badgeText = paperTypeBadgeMap[paper.type] || '科研文献';
const doiUrl = `https://doi.org/${paper.doi}`;

const testedLabelMap: Record<string, string> = {
  verified: '已验证',
  template: '命令已核对',
  'not-tested': '待验证'
};

// 获取植物应用物种信息（用于 application 论文自身展示）
const primarySpeciesId = paper.speciesIds?.[0];
const speciesName = primarySpeciesId ? (speciesLabels[primarySpeciesId] || primarySpeciesId) : null;
---

<aside class="paper-resources" aria-label="文献元数据与关联科研资源">
  <!-- 卡片 1: 文献信息 -->
  <section class="paper-card" aria-labelledby="card-meta-title">
    <div class="paper-card-header">
      <span aria-hidden="true">📄</span>
      <h3 id="card-meta-title" class="paper-card-title">文献信息</h3>
    </div>
    <div class="paper-card-body">
      <dl class="paper-meta-list">
        <dt class="paper-meta-dt">文献类型</dt>
        <dd class="paper-meta-dd"><span class="paper-badge" style="padding: 2px 8px; font-size: 11px;">{badgeText}</span></dd>
        
        <dt class="paper-meta-dt">发表期刊</dt>
        <dd class="paper-meta-dd">{paper.journal}</dd>
        
        <dt class="paper-meta-dt">发表年份</dt>
        <dd class="paper-meta-dd">{paper.year}</dd>
        
        {paper.volumePages && (
          <>
            <dt class="paper-meta-dt">卷期页码</dt>
            <dd class="paper-meta-dd">{paper.volumePages}</dd>
          </>
        )}
        
        <dt class="paper-meta-dt">DOI</dt>
        <dd class="paper-meta-dd">
          <a href={doiUrl} target="_blank" rel="noreferrer">
            {paper.doi} <span aria-hidden="true">↗</span>
          </a>
        </dd>
      </dl>
    </div>
  </section>

  <!-- 卡片 2: 关联内容 -->
  {(relatedMethods.length > 0 || relatedTopics.length > 0 || relatedTutorials.length > 0) && (
    <section class="paper-card" aria-labelledby="card-linked-title">
      <div class="paper-card-header">
        <span aria-hidden="true">🔀</span>
        <h3 id="card-linked-title" class="paper-card-title">关联内容</h3>
      </div>
      <div class="paper-card-body">
        <!-- 关联算法与工具 -->
        {relatedMethods.length > 0 && (
          <div class="paper-linked-group">
            <div class="paper-linked-heading">
              <span aria-hidden="true">🛠️</span> 相关算法与工具
            </div>
            <div class="paper-linked-list">
              {relatedMethods.map(m => (
                <a href={`${base}methods/${m.id}/`} class="paper-linked-item">
                  <span class="paper-linked-title">🍃 {m.data.name}</span>
                  <span class="paper-linked-desc">{m.data.summary}</span>
                </a>
              ))}
            </div>
          </div>
        )}

        <!-- 关联专题 -->
        {relatedTopics.length > 0 && (
          <div class="paper-linked-group">
            <div class="paper-linked-heading">
              <span aria-hidden="true">📖</span> 相关专题
            </div>
            <div class="paper-linked-list">
              {relatedTopics.slice(0, 3).map(t => (
                <a href={`${base}topics/${t.domainId}/${t.id}/`} class="paper-linked-item">
                  <span class="paper-linked-title">{t.title}</span>
                  <span class="paper-linked-desc">{t.summary}</span>
                </a>
              ))}
            </div>
          </div>
        )}

        <!-- 关联分析教程 -->
        {relatedTutorials.length > 0 && (
          <div class="paper-linked-group">
            <div class="paper-linked-heading">
              <span aria-hidden="true">🧪</span> 相关分析教程
            </div>
            <div class="paper-linked-list">
              {relatedTutorials.slice(0, 2).map(tut => (
                <a href={`${base}tutorials/${tut.id}/`} class="paper-linked-item">
                  <span class="paper-linked-title">{tut.data.title}</span>
                  <span class="paper-linked-desc">{tut.data.summary}</span>
                  <span class="paper-linked-badge">{testedLabelMap[tut.data.tested] || tut.data.tested}</span>
                </a>
              ))}
            </div>
          </div>
        )}
      </div>
    </section>
  )}

  <!-- 卡片 3: 植物研究应用卡片 -->
  <!-- 场景 A: 方法学论文找到了真实植物应用案例 (如 Hifiasm 对应的 Macadamia) -->
  {paper.type === 'method' && plantApplicationPaper && (
    <section class="paper-card" aria-labelledby="card-plant-title">
      <div class="paper-card-header">
        <span aria-hidden="true">🌱</span>
        <h3 id="card-plant-title" class="paper-card-title">植物研究应用</h3>
      </div>
      <div class="paper-card-body">
        <div class="paper-plant-card">
          <div class="paper-plant-spotlight">
            <div class="paper-plant-img" aria-hidden="true">
              🌰
            </div>
            <div class="paper-plant-info">
              <h4 class="paper-plant-name">
                {plantApplicationPaper.data.title.includes('Macadamia') ? '澳洲坚果' : '植物应用研究'}
                <em>{speciesLabels[plantApplicationPaper.data.speciesIds?.[0]] || ''}</em>
              </h4>
              <p class="paper-plant-desc">
                {plantApplicationPaper.data.summary}
              </p>
            </div>
          </div>
          <a href={`${base}papers/${plantApplicationPaper.id}/`} class="paper-plant-link">
            查看案例详情 →
          </a>
        </div>
      </div>
    </section>
  )}

  <!-- 场景 B: 植物应用论文自身，突出其研究植物对象 -->
  {paper.type === 'application' && speciesName && (
    <section class="paper-card" aria-labelledby="card-target-plant-title">
      <div class="paper-card-header">
        <span aria-hidden="true">🌿</span>
        <h3 id="card-target-plant-title" class="paper-card-title">研究植物对象</h3>
      </div>
      <div class="paper-card-body">
        <div class="paper-plant-card">
          <div class="paper-plant-spotlight">
            <div class="paper-plant-img" aria-hidden="true">
              🌱
            </div>
            <div class="paper-plant-info">
              <h4 class="paper-plant-name">
                {speciesName}
              </h4>
              <p class="paper-plant-desc">
                本研究所聚焦的核心植物材料，结合长短读长组装、群体变异或转录调控分析开展科学探索。
              </p>
            </div>
          </div>
        </div>
      </div>
    </section>
  )}
</aside>
