---
// ContentFeedback.astro: 页面底部 GitHub Issue 反馈与在线编辑入口
export interface Props {
  sourcePath?: string;
  pageTitle?: string;
}

const { sourcePath = '', pageTitle = '' } = Astro.props;
const currentUrl = Astro.url.href;
const repoBase = 'https://github.com/hao1006sy-source/phytomethods';

// 构造编辑链接
const editUrl = sourcePath ? `${repoBase}/edit/main/${sourcePath}` : `${repoBase}/tree/main`;

// 构造问题反馈链接 (预填 Issue 模板或参数)
const issueBase = `${repoBase}/issues/new`;
const issueTitle = `[内容反馈] ${pageTitle || '页面反馈'}`;
const issueBody = `### 反馈页面信息
- **页面标题**: ${pageTitle}
- **页面链接**: ${currentUrl}
- **文件路径**: \`${sourcePath}\`

### 问题类型
- [ ] 内容错误或描述不准确
- [ ] 软件参数或命令已过时
- [ ] 示例数据或链接失效
- [ ] 其他建议与完善

### 详细说明
<!-- 请在此处详细描述您发现的问题或建议的正确内容 -->

`;

const reportIssueUrl = `${issueBase}?title=${encodeURIComponent(issueTitle)}&body=${encodeURIComponent(issueBody)}`;
---

<div class="content-feedback-bar" data-pagefind-ignore>
  <div class="feedback-inner">
    <div class="feedback-meta">
      <svg class="feedback-icon" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
        <path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"></path>
        <path d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z"></path>
      </svg>
      <span>学术严谨与透明：欢迎对本页内容参与纠错与维护</span>
    </div>
    <div class="feedback-actions">
      {sourcePath && (
        <a href={editUrl} target="_blank" rel="noreferrer" class="feedback-btn edit-btn">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <path d="M12 20h9"></path>
            <path d="M16.5 3.5a2.121 2.121 0 0 1 3 3L7 19l-4 1 1-4L16.5 3.5z"></path>
          </svg>
          在 GitHub 上编辑此页 ↗
        </a>
      )}
      <a href={reportIssueUrl} target="_blank" rel="noreferrer" class="feedback-btn issue-btn">
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <circle cx="12" cy="12" r="10"></circle>
          <line x1="12" y1="8" x2="12" y2="12"></line>
          <line x1="12" y1="16" x2="12.01" y2="16"></line>
        </svg>
        反馈内容或参数问题 ↗
      </a>
    </div>
  </div>
</div>

<style>
.content-feedback-bar {
  margin: 40px 0 20px;
  padding: 14px 18px;
  background: var(--bg-card, #ffffff);
  border: 1px dashed var(--border, #cbded0);
  border-radius: 8px;
  font-size: 13px;
  color: var(--text-muted, #557566);
}
.feedback-inner {
  display: flex;
  align-items: center;
  justify-content: space-between;
  flex-wrap: wrap;
  gap: 12px;
}
.feedback-meta {
  display: inline-flex;
  align-items: center;
  gap: 8px;
  font-weight: 500;
}
.feedback-icon {
  color: var(--teal, #0e6548);
  flex-shrink: 0;
}
.feedback-actions {
  display: flex;
  align-items: center;
  gap: 10px;
  flex-wrap: wrap;
}
.feedback-btn {
  display: inline-flex;
  align-items: center;
  gap: 5px;
  padding: 5px 11px;
  border-radius: 6px;
  font-size: 12.5px;
  font-weight: 600;
  text-decoration: none;
  transition: all 0.15s ease;
}
.edit-btn {
  background: var(--bg-subtle, #f0f5f2);
  color: var(--text, #1e4533);
  border: 1px solid var(--border, #cbded0);
}
.edit-btn:hover {
  background: var(--teal-soft, #e2efe8);
  border-color: var(--teal, #0e6548);
}
.issue-btn {
  background: var(--teal-soft, #eef7f2);
  color: var(--teal, #0e6548);
  border: 1px solid var(--teal-border, #c3dfd0);
}
.issue-btn:hover {
  background: var(--teal, #0e6548);
  color: #ffffff;
}
@media(max-width: 600px) {
  .feedback-inner {
    flex-direction: column;
    align-items: flex-start;
  }
  .feedback-actions {
    width: 100%;
  }
  .feedback-btn {
    flex: 1;
    justify-content: center;
  }
}
</style>
