---
import AssemblyOverview from '../AssemblyOverview.astro';
import MethodComparisonMatrix from './MethodComparisonMatrix.astro';
import ContentFeedback from '../ContentFeedback.astro';
import {topicMetadata} from '../../data/topics';
import {domains} from '../../data/domains';
import {getCollection} from 'astro:content';
import './domain-v2.css';
const base=import.meta.env.BASE_URL;
const articles=await getCollection('topics');
const topics=topicMetadata.filter(t=>t.domainId==='genome-assembly'&&t.status==='published'&&articles.some(a=>a.id===t.id&&a.data.status==='published')).sort((a,b)=>a.order-b.order);
const methods=(await getCollection('methods')).filter(m=>['hifiasm','verkko','merqury'].includes(m.id)).sort((a,b)=>['hifiasm','verkko','merqury'].indexOf(a.id)-['hifiasm','verkko','merqury'].indexOf(b.id));
const sections=[['overview','领域概览'],['workflow','技术路线'],['topics','七大专题'],['methods','核心方法'],['resources','研究资源']];
const stages=[['样本与数据准备','样本鉴定、DNA 提取与测序设计'],['测序数据质控','检查 reads 质量、覆盖度与污染'],['组装图与 Contig','构建组装图，解析路径与序列'],['染色体挂载','利用 Hi-C 等长程证据排序与定向'],['组装质量评估','综合检查完整性、准确率与连续性']];
---
<div class="m01-v2">
<nav class="m01-breadcrumb" aria-label="面包屑"><a href={base}>⌂ 首页</a><span>›</span><a href={`${base}topics/`}>研究领域</a><span>›</span><span>M01 测序与基因组组装</span></nav>
<header class="m01-hero"><div class="m01-heading"><div class="m01-badges"><span>M01</span><span>研究领域</span></div><div><div class="m01-title-line"><h1>测序与基因组组装</h1><span>Genome Assembly</span></div><p>从测序数据重建染色体序列，获得高质量植物参考基因组。</p></div></div>
<figure class="m01-sequence"><svg viewBox="0 0 510 90" role="img" aria-label="原理示意：短读段组装成连续片段，再利用长程证据排列成含间隙的 scaffold"><g stroke="#087a50" stroke-width="3" stroke-linecap="round"><path d="M12 20h23m-8-11h25m-8 21h23m-53 4h19m10 9h22m-2-24h23m-8 24h22"/></g><g fill="#cce2ce" stroke="#087a50" stroke-width="1.5"><rect x="180" y="20" width="52" height="10" rx="4"/><rect x="203" y="5" width="65" height="10" rx="4"/><rect x="236" y="35" width="55" height="10" rx="4"/><rect x="373" y="15" width="46" height="14" rx="4"/><rect x="428" y="15" width="39" height="14" rx="4"/><rect x="476" y="15" width="27" height="14" rx="4"/></g><g stroke="#60736a" stroke-width="1.5"><path d="M419 22h9m39 0h9" stroke-dasharray="2 2"/><path d="M130 24h20m-6-5 6 5-6 5M325 24h20m-6-5 6 5-6 5"/></g><g text-anchor="middle" fill="#25362f" font-size="14"><text x="54" y="75">Reads</text><text x="234" y="75">Contigs</text><text x="438" y="75">Scaffolds</text></g></svg><figcaption>原理示意 · 虚线表示片段间隙</figcaption></figure></header>
<div class="m01-grid"><aside class="m01-sidebar"><nav aria-label="M01 领域导航">{sections.map(([id,label],i)=><a href={`#m01-${id}`} class:list={{active:i===0}} data-section={id}><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" aria-hidden="true"><path d={['M6 3h9l4 4v14H6zM9 10h7M9 14h7M9 18h4','M5 18 10 6l9 12M5 18h14','M4 4h16v16H4zM8 9h8M8 14h8','M6 4h12v16H6zM9 8h6M9 12h6','M4 5h7l1 2h8v14H4z'][i]}/></svg>{label}</a>)}</nav><div class="m01-local"><strong>本页目录</strong>{sections.map(([id,label],i)=><a href={`#m01-${id}`}>{i+1}　{label}</a>)}<a href="#m01-background">6　研究背景与方法</a></div></aside>
<article class="m01-main"><section id="m01-overview"><h2>领域概览</h2><p>测序与基因组组装是获得高质量植物参考基因组的基础。本领域涵盖测序技术与数据处理、组装图与核心算法、单倍型解析、Hi-C 辅助染色体挂载、T2T 与质量评估。植物的重复序列、杂合性与多倍体增加路径解析难度；组装结果为基因组注释、变异分析和比较基因组研究提供序列坐标。</p></section>
<section id="m01-workflow"><h2>技术路线：从测序到染色体组装</h2><ol class="m01-workflow">{stages.map(([name,desc],i)=><li><span class="m01-stage-icon" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7"><path d={['M10 3h7l1 3-7 14H5L4 17l7-14M8 12l5 2','M4 6c0-4 16-4 16 0v12c0 4-16 4-16 0ZM4 6c0 4 16 4 16 0M4 12c0 4 16 4 16 0','M5 18 11 5l8 13M5 18h14','M7 3c-7 7 15 11 10 18M17 3c7 7-15 11-10 18','M4 20v-7h4v7m4 0V8h4v12m4 0V3h3v17'][i]}/></svg></span><div><strong>{name}</strong><p>{desc}</p></div></li>)}</ol><p class="m01-caption">概括性技术路线：各阶段可选择不同方法；图示并非单一软件的内部算法。</p></section>
<section id="m01-topics"><h2>七大专题</h2><div class="m01-topic-list">{topics.map(t=><a href={`${base}topics/genome-assembly/${t.id}/`}><span class="m01-number">{String(t.order).padStart(2,'0')}</span><strong>{t.title}</strong><span class="m01-summary">{t.summary}</span><span class="m01-read">阅读专题 →</span></a>)}</div></section>
<section id="m01-methods"><h2>关键方法与工具</h2><div class="m01-method-list">{methods.map(m=><a href={`${base}methods/${m.id}/`}><strong>{m.data.name}</strong><span>{m.data.summary}</span><span aria-hidden="true">→</span></a>)}</div></section>
<MethodComparisonMatrix domainId="genome-assembly" />
<section id="m01-background" class="m01-background"><h2>研究背景与方法</h2><AssemblyOverview/></section>
<section id="m01-resources"><h2>研究资源</h2><div class="m01-resource-links"><a href={`${base}papers/`}>方法论文与植物案例 →</a><a href={`${base}tutorials/hifiasm-intro/`}>Hifiasm 组装入门 →</a><a href={`${base}tutorials/`}>全部分析教程 →</a></div></section><div style="margin-top:2rem;"><ContentFeedback pageTitle="M01 测序与基因组组装 研究领域" sourcePath="src/data/domains.ts" /></div></article>
<aside class="m01-panels"><section><h2><svg viewBox="0 0 24 24" aria-hidden="true"><path d="m3 8 9-5 9 5-9 5ZM3 12l9 5 9-5M3 16l9 5 9-5"/></svg>核心方法与工具</h2><div>{methods.map(m=><a class="m01-tool" href={`${base}methods/${m.id}/`}><strong>{m.data.name}</strong><span>{m.data.summary}</span></a>)}<a class="m01-more" href={`${base}methods/`}>查看全部方法与工具 →</a></div></section><section><h2><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 5C8 2 4 3 3 4v15c4-2 7-1 9 1 2-2 5-3 9-1V4c-1-1-5-2-9 1ZM12 5v15"/></svg>推荐阅读</h2><div><ul>{topics.map(t=><li><a href={`${base}topics/genome-assembly/${t.id}/`}>{t.title}</a></li>)}</ul><a class="m01-more" href={`${base}papers/`}>查看全部文献 →</a></div></section><section><h2><svg viewBox="0 0 24 24" aria-hidden="true"><path d="m6 17 6-12 6 12M6 17h12"/><circle cx="12" cy="5" r="3"/><circle cx="5" cy="18" r="3"/><circle cx="19" cy="18" r="3"/></svg>相关研究领域</h2><div>{domains.filter(d=>['M02','M03','M04'].includes(d[0])).map(d=><a class="m01-related" href={`${base}topics/${d[1]}/`}><strong>{d[0]}</strong><span>{d[2]}</span></a>)}</div></section></aside></div></div>
<script>
const root=document.querySelector('.m01-v2');
if(root){const links=[...root.querySelectorAll<HTMLAnchorElement>('[data-section]')];const observer=new IntersectionObserver(entries=>{for(const entry of entries){if(entry.isIntersecting){links.forEach(a=>{const active=a.hash==='#'+entry.target.id;a.classList.toggle('active',active);if(active)a.setAttribute('aria-current','location');else a.removeAttribute('aria-current');});}}},{rootMargin:'-10% 0px -65% 0px'});root.querySelectorAll('.m01-main>section').forEach(s=>observer.observe(s));}
</script>
