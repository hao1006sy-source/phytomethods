---
import TutorialSidebar from './TutorialSidebar.astro';
import './tutorial-v3.css';
const {ids,titles}=Astro.props;
---
<div class="tutorial-v3"><div class="tv3-page-header"><slot name="header"/></div><div class="tv3-columns"><TutorialSidebar ids={ids} titles={titles}/><article class="tv3-main"><slot/></article><aside class="tv3-resources"><slot name="resources"/></aside></div></div>
<script>
const root=document.querySelector('.tutorial-v3');
if(root){
 // Base enhances all pre elements. This reusable component owns its accessible toolbar.
 const removeLegacyToolbars=()=>root.querySelectorAll('.tv3-code .code-toolbar').forEach(el=>el.remove());
 removeLegacyToolbars();new MutationObserver(records=>{if(records.some(r=>[...r.addedNodes].some(n=>n instanceof Element&&n.classList.contains('code-toolbar'))))removeLegacyToolbars();}).observe(root,{childList:true,subtree:true});

 const details=root.querySelector<HTMLDetailsElement>('.tv3-sidebar details');if(matchMedia('(max-width:1000px)').matches)details?.removeAttribute('open');
 const links=[...root.querySelectorAll<HTMLAnchorElement>('.tv3-sidebar a')];const sections=links.map(l=>document.getElementById(l.hash.slice(1))).filter((s):s is HTMLElement=>!!s);
 function active(){const current=sections.filter(s=>s.getBoundingClientRect().top<=135).at(-1)??sections[0];links.forEach(l=>{if(l.hash===`#${current?.id}`)l.setAttribute('aria-current','location');else l.removeAttribute('aria-current');});}let pending=false;window.addEventListener('scroll',()=>{if(!pending){pending=true;requestAnimationFrame(()=>{active();pending=false;});}},{passive:true});active();
 root.querySelectorAll<HTMLButtonElement>('.tv3-copy').forEach(button=>button.addEventListener('click',async()=>{const box=button.closest('.tv3-code')!;const code=box.querySelector('code')!.textContent??'';const status=box.querySelector('.tv3-copy-status')!;try{await navigator.clipboard.writeText(code);status.textContent='已复制';setTimeout(()=>status.textContent='',1800);}catch{status.textContent='复制失败，请选择代码手动复制';}}));
 const dialog=root.querySelector<HTMLDialogElement>('.tv3-figure-dialog');const trigger=root.querySelector<HTMLButtonElement>('.tv3-zoom');trigger?.addEventListener('click',()=>{const target=dialog!.querySelector('.tv3-figure-target')!;target.replaceChildren(root.querySelector('.tv3-workflow svg')!.cloneNode(true));target.querySelectorAll('[id]').forEach(el=>el.id+='-zoom');target.querySelectorAll('[marker-end]').forEach(el=>el.setAttribute('marker-end','url(#tv3-arrow-zoom)'));dialog!.showModal();});dialog?.querySelector('button')?.addEventListener('click',()=>dialog.close());dialog?.addEventListener('click',e=>{if(e.target===dialog)dialog.close();});dialog?.addEventListener('close',()=>trigger?.focus());
}
</script>
