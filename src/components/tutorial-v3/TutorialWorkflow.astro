---
const {steps}=Astro.props;
---
<div class="tv3-workflow" role="figure" aria-label="Hifiasm 教学流程"><header><h3>分析流程概览</h3><button type="button" class="tv3-zoom" aria-haspopup="dialog">放大流程图</button></header><div class="tv3-svg-scroll" tabindex="0" aria-label="工作流图，可横向滚动查看"><svg viewBox="0 0 720 180" role="img" aria-label="HiFi reads 经数据检查、Hifiasm 组装、GFA 结果、FASTA 导出及质量评估的教学流程"><defs><marker id="tv3-arrow" markerWidth="6" markerHeight="6" refX="5" refY="3" orient="auto"><path d="M0 0L6 3L0 6" fill="none" stroke="#0e6548"/></marker></defs>{steps.map(([name,sub]:string[],i:number)=><g transform={`translate(${i*119+5},10)`}><rect x="0" y="0" width="110" height="130" rx="12" fill="#f0faf3" stroke="#bfddca"/><g transform="translate(35,16)" fill="none" stroke="#0e6548" stroke-width="2" stroke-linecap="round">{i===0?<><ellipse cx="20" cy="6" rx="17" ry="6"/><path d="M3 6v26c0 8 34 8 34 0V6M3 17c0 8 34 8 34 0M3 26c0 8 34 8 34 0"/></>:i===1?<><circle cx="17" cy="16" r="13"/><path d="m27 26 13 13"/></>:i===2?<><circle cx="20" cy="20" r="15"/><circle cx="20" cy="20" r="6"/><path d="M20 0v5m0 30v5M0 20h5m30 0h5"/></>:i===5?<><path d="M2 39h38M5 36V24h6v12m6 0V14h6v22m6 0V3h6v33"/></>:<><path d="M8 1h19l9 9v30H8ZM27 1v10h9M14 19h16m-16 7h16m-16 7h12"/></>}</g><text x="55" y="83" text-anchor="middle" font-size="13" font-weight="700" fill="#104a36">{name}</text><text x="55" y="106" text-anchor="middle" font-size="11" fill="#65786e">{sub}</text>{i<5&&<path d="M111 65h8" stroke="#0e6548" marker-end="url(#tv3-arrow)"/>}</g>)}</svg></div><p class="tv3-caption">教学流程示意，非真实测序结果。</p></div>
<dialog class="tv3-figure-dialog" aria-label="放大教学流程图"><button type="button" class="tv3-close">关闭流程图</button><div class="tv3-figure-target" tabindex="0"></div><p>教学流程示意，非真实测序结果。</p></dialog>
