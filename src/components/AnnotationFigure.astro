---
const {kind}=Astro.props;
const figures:Record<string,{title:string;lines:string[]}>={
'm02-topic-01':{title:'基因结构与注释流程',lines:['基因组：上游 ── 外显子 1 ── 内含子 ── 外显子 2 ── 下游','转录本：5′ UTR ── CDS ── CDS ── 3′ UTR','基因组 → 重复识别 → 结构预测 → 功能注释 → 质量评估']},
'm02-topic-02':{title:'转座元件分类与识别',lines:['Class I：LTR / LINE / SINE　｜　Class II：DNA 转座子','完整 LTR 元件：LTR ── 内部区域 ── LTR','结构特征 + 序列同源 → 分类、去冗余 → 重复序列库']},
'm02-topic-03':{title:'BRAKER3 证据整合流程',lines:['基因组 + RNA-seq + 同源蛋白 → GeneMark-ETP','训练及预测 → AUGUSTUS　｜　证据筛选 → TSEBRA','预测基因模型 → GFF / 蛋白序列 → 质量评估']},
 'm02-topic-04':{title:'转录本证据与基因结构',lines:['基因组：外显子 1 ── 内含子 ── 外显子 2 ── 内含子 ── 外显子 3','转录本 A：外显子 1 ── 外显子 2 ── 外显子 3','转录本 B：外显子 1 ─────────── 外显子 3']},
'm02-topic-05':{title:'RNA 结构与同源推断',lines:['RNA 序列：G ─ C　A ─ U　G ─ C　（示意配对）','保守序列 + 配对关系 → 协方差模型','模型搜索 → 候选 RNA → 结构及证据核查']},
'm02-topic-06':{title:'蛋白结构域与功能注释',lines:['蛋白序列：── 结构域 A ───── 结构域 B ──','蛋白序列 → 成员数据库签名匹配 → InterPro 条目','整合同源、结构域和 GO 等证据 → 功能描述']},
'm02-topic-07':{title:'基因组注释质量评估',lines:['基因组与证据质量 → 结构模型检查','BUSCO / OMArk + 表达与蛋白支持 → 综合评价','重复相关注释、污染、片段与多倍体背景 → 人工复核']}};
const f=figures[kind];
---
<figure class="annotation-figure">{kind==='m02-topic-01' ? <svg viewBox="0 0 760 200" role="img" aria-label="外显子内含子与 UTR 和 CDS 示意"><title>外显子、内含子、UTR 与 CDS</title><path d="M55 75 H705" stroke="#79939a" stroke-width="3"/><rect x="100" y="60" width="55" height="30" fill="#aacbc2"/><rect x="155" y="52" width="150" height="46" fill="#197b73"/><rect x="465" y="52" width="135" height="46" fill="#197b73"/><rect x="600" y="60" width="55" height="30" fill="#aacbc2"/><text x="100" y="40" font-size="16">外显子 1</text><text x="465" y="40" font-size="16">外显子 2</text><text x="330" y="68" font-size="16">内含子</text><text x="105" y="130" font-size="16">5′ UTR</text><text x="225" y="130" font-size="16">CDS</text><text x="605" y="130" font-size="16">3′ UTR</text><text x="80" y="175" font-size="15">深色为编码区，浅色为非翻译区；方框表示外显子部分。</text></svg> : kind==='m02-topic-02' ? <svg viewBox="0 0 760 170" role="img" aria-label="LTR 逆转座元件的结构示意"><title>LTR 逆转座元件结构</title><path d="M35 85 H725" stroke="#90a9aa" stroke-width="4"/><rect x="90" y="52" width="100" height="66" rx="5" fill="#197b73"/><rect x="190" y="60" width="380" height="50" fill="#d9ebe8" stroke="#197b73"/><rect x="570" y="52" width="100" height="66" rx="5" fill="#197b73"/><text x="120" y="92" fill="white" font-size="18">LTR</text><text x="345" y="92" fill="#17324d" font-size="18">内部区域</text><text x="600" y="92" fill="white" font-size="18">LTR</text><text x="85" y="150" font-size="15">两端重复与内部结构是完整 LTR 候选识别线索。</text></svg> : <svg viewBox={`0 0 760 ${f.lines.length*62+25}`} role="img" aria-label={f.title}><title>{f.title}</title>{f.lines.map((line,i)=><g><rect x="10" y={8+i*62} width="740" height="48" rx="8" fill={i%2?'#e8f3f0':'#edf3f7'} stroke="#b5cfcc"/><text x="25" y={39+i*62} font-size="16" fill="#17324d">{line}</text></g>)}</svg>}<figcaption>{f.title}。原理示意，符号和结构用于教学，不代表实测数据。</figcaption></figure>
{kind==='m02-topic-03' && <section class="card hmm"><h2>隐状态教学演示</h2><p>示意 DNA 与三个候选状态；该演示展示状态序列，不执行真实预测、概率计算或 BRAKER3。</p><div class="hmm-states"><span id="hmm-a">基因间区</span><span id="hmm-b">外显子</span><span id="hmm-c">内含子</span><span id="hmm-d">外显子</span></div><p><code>ACGT ─ ATGG ─ GTAA ─ CCTG</code></p><p id="hmm-text" aria-live="polite">第 1 步：观察序列，模型从基因间状态开始。</p><button id="hmm-prev">上一步</button> <button id="hmm-next">下一步</button> <button id="hmm-reset">重置</button></section>}
<script>
let step=0;const labels=['第 1 步：观察序列，模型从基因间状态开始。','第 2 步：候选外显子状态根据观测碱基和转移得分参与比较。','第 3 步：候选内含子状态反映可能的剪接连接。','第 4 步：再次进入外显子，得到一条教学示意路径。'];function draw(){for(let i=0;i<4;i++)document.querySelector(`#hmm-${'abcd'[i]}`)?.classList.toggle('on',i===step);const p=document.querySelector('#hmm-text');if(p)p.textContent=labels[step]}document.querySelector('#hmm-prev')?.addEventListener('click',()=>{step=Math.max(0,step-1);draw()});document.querySelector('#hmm-next')?.addEventListener('click',()=>{step=Math.min(3,step+1);draw()});document.querySelector('#hmm-reset')?.addEventListener('click',()=>{step=0;draw()});draw();
</script>
<style>.annotation-figure{overflow:auto}.annotation-figure svg{width:100%;min-width:650px;height:auto}.hmm{overflow:auto;margin:2rem 0}.hmm-states{display:flex;gap:8px;min-width:520px;margin:20px 0}.hmm-states span{background:#edf3f7;border:1px solid #c6d9dc;border-radius:8px;padding:10px}.hmm-states .on{background:#197b73;color:white}</style>
