---
import {domains} from '../../data/domains';
import {topicMetadata} from '../../data/topics';
import './article-v2.css';
const {entry,metadata,headings,topicEntries=[],relatedMethods=[],relatedPapers=[],relatedTutorials=[],highlights=[]}=Astro.props;
const base=import.meta.env.BASE_URL;
const domain=domains.find(d=>d[1]===metadata.domainId);
if(!domain) throw new Error(`Unknown topic domain: ${metadata.domainId} (${metadata.id})`);
const topics=topicMetadata.filter(t=>t.domainId===metadata.domainId&&t.status==='published').sort((a,b)=>a.order-b.order).map(t=>({...t,title:topicEntries.find((item:any)=>item.id===t.id)?.data.title??t.title}));
const pos=topics.findIndex(t=>t.id===metadata.id);
const sections=[] as {slug:string;text:string;depth:number;number:string}[];
let major=0,minor=0;
for(const heading of headings.filter((h:any)=>h.depth===2||h.depth===3)){
  if(heading.depth===2){major++;minor=0;sections.push({slug:heading.slug,text:heading.text,depth:2,number:String(major).padStart(2,'0')});}
  else {minor++;sections.push({slug:heading.slug,text:heading.text,depth:3,number:`${String(major).padStart(2,'0')}.${minor}`});}
}
const url=(t:any)=>`${base}topics/${metadata.domainId}/${t.id}/`;
---
<div class="topic-v2">
<div class="article-progress" role="progressbar" aria-label="阅读进度" aria-valuemin="0" aria-valuemax="100" aria-valuenow="0"><span></span></div>
<nav class="article-crumb" aria-label="面包屑"><a href={base}>⌂ 首页</a> › <a href={`${base}topics/`}>研究领域</a> › <a href={`${base}topics/${domain[1]}/`}>{domain[2]}</a> › <span>{entry.data.title}</span></nav>
<header class="article-hero"><div class="article-badges"><b>{domain[0]}</b><span>专题 {String(pos+1).padStart(2,'0')} / {String(topics.length).padStart(2,'0')}</span></div><div class="article-heading"><div><h1>{entry.data.title}</h1><span>{metadata.englishTitle}</span></div><p>{entry.data.summary}</p></div><time datetime={entry.data.updatedAt.toISOString()}>更新日期：{entry.data.updatedAt.toISOString().slice(0,10)}</time></header>
<div class="article-grid">
<aside class="article-left"><details open><summary>{domain[2]}</summary><nav aria-label="所属领域专题">{topics.map((t,i)=><a href={url(t)} aria-current={t.id===metadata.id?'page':undefined}><span>{String(i+1).padStart(2,'0')}</span>{t.title}</a>)}</nav><a class="return-domain" href={`${base}topics/${domain[1]}/`}>← 返回领域概览</a></details></aside>
<article class="article-body"><section class="article-highlights"><h2><span aria-hidden="true">◎</span> 本篇要点</h2><ul>{highlights.map((text:string)=><li>{text}</li>)}</ul></section><details class="article-mobile-toc"><summary>本页内容</summary><nav>{sections.map((h)=><a class:list={[`depth-${h.depth}`]} href={`#${h.slug}`}><span>{h.number}</span>　{h.text}</a>)}</nav></details><article class="article-content prose"><slot/><slot name="after-first-table"/></article><section class="article-learning"><h2>延伸学习</h2>{relatedMethods.length>0&&<><h3>相关算法与工具</h3><div>{relatedMethods.map((m:any)=><a href={`${base}methods/${m.id}/`}>{m.data.name}</a>)}</div></>}{relatedPapers.length>0&&<><h3>方法论文与植物案例</h3><ul>{relatedPapers.map((p:any)=><li><a href={`${base}papers/${p.id}/`}>{p.data.title}</a></li>)}</ul></>}{relatedTutorials.length>0&&<><h3>分析教程</h3><ul>{relatedTutorials.map((t:any)=><li><a href={`${base}tutorials/${t.id}/`}>{t.data.title}</a></li>)}</ul></>}</section><nav class="article-pagination" aria-label="专题前后导航"><a href={`${base}topics/${domain[1]}/`}>返回领域概览</a>{pos>0&&<a href={url(topics[pos-1])}>上一篇：{topics[pos-1].title}</a>}{pos<topics.length-1&&<a href={url(topics[pos+1])}>下一篇：{topics[pos+1].title} →</a>}</nav></article>
<aside class="article-right"><nav class="article-toc" aria-label="本页章节"><h2>本页内容</h2>{sections.map(h=><a class:list={[`depth-${h.depth}`]} href={`#${h.slug}`}><span>{h.number}</span>{h.text}</a>)}</nav>{relatedMethods.length>0&&<section class="article-resources"><h2><span aria-hidden="true">▱</span> 相关资源</h2>{relatedMethods.map((m:any)=><a href={`${base}methods/${m.id}/`}><strong>{m.data.name}</strong><span>{m.data.summary}</span></a>)}<a class="all-methods" href={`${base}methods/`}>查看全部方法与工具 →</a></section>}</aside>
</div></div>
<script>
const root=document.querySelector('.topic-v2');
if(root){
const titles=[...root.querySelectorAll<HTMLElement>('.article-content h2')];titles.forEach((h,i)=>{const n=document.createElement('span');n.className='section-number';n.textContent=String(i+1).padStart(2,'0')+' ';h.prepend(n);});
const firstTable=root.querySelector('.article-content table');
const deferredFigure=root.querySelector<HTMLElement>('[data-after-first-table]');
if(deferredFigure){const host=firstTable?.closest('.table-scroll')??firstTable;if(host){host.after(deferredFigure);deferredFigure.removeAttribute('data-after-first-table');}else deferredFigure.remove();}
const links=[...root.querySelectorAll<HTMLAnchorElement>('.article-toc a')];
if('IntersectionObserver'in window){const observer=new IntersectionObserver(entries=>{for(const e of entries)if(e.isIntersecting)links.forEach(a=>{const active=decodeURIComponent(a.hash.slice(1))===e.target.id;a.classList.toggle('active',active);if(active)a.setAttribute('aria-current','location');else a.removeAttribute('aria-current');});},{rootMargin:'-90px 0px -65% 0px'});root.querySelectorAll<HTMLElement>('.article-content h2,.article-content h3').forEach(t=>observer.observe(t));}
const progress=root.querySelector<HTMLElement>('.article-progress')!;const update=()=>{const article=root.querySelector('.article-content')!;const top=article.getBoundingClientRect().top+scrollY;const length=Math.max(1,article.scrollHeight-innerHeight);const percent=Math.max(0,Math.min(100,(scrollY-top)/length*100));progress.style.setProperty('--progress',percent+'%');progress.setAttribute('aria-valuenow',String(Math.round(percent)));};addEventListener('scroll',update,{passive:true});addEventListener('resize',update);update();
const mq=matchMedia('(max-width: 900px)');const fold=()=>{const d=root.querySelector('.article-left details');if(mq.matches)d?.removeAttribute('open');else d?.setAttribute('open','');};mq.addEventListener('change',fold);fold();
}
</script>
