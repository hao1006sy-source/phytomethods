---
import 'katex/dist/katex.min.css';
import '../styles/themes.css';
import '../styles/global.css';
import '../styles/home.css';
import '../styles/nav-v3.css';
import BrandLogo from '../components/BrandLogo.astro';
import ThemeSwitcher from '../components/ThemeSwitcher.astro';
const { title = 'PhytoMethods', home = false, description = '植物基因组学与生物信息学方法知识库，涵盖基因组组装、注释、泛基因组、群体遗传、GWAS、表观组学、单细胞及调控网络等九大研究领域的算法工具、经典文献与实战教程。' } = Astro.props;
const base = import.meta.env.BASE_URL;
const path = Astro.url.pathname;
const nav = [
  ['首页', ''],
  ['研究领域', 'topics/'],
  ['算法与工具', 'methods/'],
  ['路线图', 'workflows/'],
  ['知识关联', 'knowledge/'],
  ['文献索引', 'papers/'],
  ['分析教程', 'tutorials/'],
  ['基因组资源', 'genomes/'],
  ['搜索', 'search/'],
] as const;
const githubUrl = 'https://github.com/hao1006sy-source/phytomethods';
const isCurrent = (href: string) => href ? path.startsWith(`${base}${href}`) : path === base || path === `${base}/`;
---
<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <link rel="icon" type="image/svg+xml" href={`${base}favicon.svg`} />
    <title>{title} | PhytoMethods</title>
  </head>
  <body class:list={['site-body', { 'home-body': home }]}>
    <header class:list={['site-header', { 'home-header': home }]}>
      <div class="wrap header-inner">
        <a href={base} class="brand-lockup" aria-label="PhytoMethods 首页">
          <BrandLogo />
        </a>

        <nav class="site-nav" aria-label="主导航">
          {nav.map(([label, href]) => (
            <a href={`${base}${href}`} class:list={{ 'nav-search': href === 'search/', 'is-current': isCurrent(href) }} aria-current={isCurrent(href) ? 'page' : undefined}>{label}</a>
          ))}
          <ThemeSwitcher />
          <a class="nav-github" href={githubUrl} target="_blank" rel="noreferrer">GitHub <span aria-hidden="true">↗</span></a>
        </nav>

        <details class="mobile-nav">
          <summary class="mobile-nav-toggle" aria-label="展开主导航">
            <svg viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M4 7h16M4 12h16M4 17h16" /></svg>
            <span>菜单</span>
          </summary>
          <nav class="mobile-nav-panel" aria-label="移动主导航">
            {nav.map(([label, href]) => (
              <a href={`${base}${href}`} aria-current={isCurrent(href) ? 'page' : undefined}>{label}</a>
            ))}
            <div style="padding: 8px 12px; border-top: 1px solid var(--border); margin-top: 4px;">
              <ThemeSwitcher />
            </div>
            <a href={githubUrl} target="_blank" rel="noreferrer">GitHub <span aria-hidden="true">↗</span></a>
          </nav>
        </details>
      </div>
    </header>

    <main class:list={['wrap', { 'home-main': home }]} data-pagefind-body>
      <slot />
      {['topics/','tutorials/','workflows/','search/'].some(route=>path===`${base}${route}`) && <aside style="margin-top:24px;padding:18px;border:1px solid #dfebe3;border-radius:10px"><a href={`${base}genomes/`}>基因组资源 · 查找参考序列与配套注释 →</a></aside>}
      {path.includes(`${base}tutorials/`) && path!==`${base}tutorials/` && <aside style="margin-top:24px;padding:18px;border:1px solid #dfebe3;border-radius:10px"><a href={`${base}genomes/`}>查找植物参考基因组与配套注释 →</a><p>组装、VCF、基因模型和重复序列分析应使用一致的参考坐标与染色体命名。</p></aside>}

    </main>

    <footer class:list={['site-footer', { 'home-footer': home }]}>
      <div class="wrap footer-inner">
        <div>
          <a href={base} class="footer-brand" aria-label="PhytoMethods 首页"><BrandLogo /></a>
          <div class="footer-note">植物基因组学与生物信息学方法知识库</div>
        </div>
        <div class="footer-links">
          <a href={`${base}about/`}>关于本站</a>
          <a href={`${base}papers/`}>内容来源</a>
          <a href={githubUrl} target="_blank" rel="noreferrer">GitHub ↗</a>
        </div>
      </div>
    </footer>
  </body>
</html>
<script>
  let figureDialogSequence = 0;

  function enableHorizontalKeyboardScroll(element: HTMLElement) {
    if (element.dataset.pmScrollKeyboard === 'true') return;
    element.dataset.pmScrollKeyboard = 'true';
    element.addEventListener('keydown', event => {
      if (element.scrollWidth <= element.clientWidth + 1) return;
      const distance = Math.max(40, Math.round(element.clientWidth * 0.15));
      const key = (event as KeyboardEvent).key;
      if (key === 'ArrowRight') {
        event.preventDefault();
        element.scrollLeft = Math.min(element.scrollWidth - element.clientWidth, element.scrollLeft + distance);
      } else if (key === 'ArrowLeft') {
        event.preventDefault();
        element.scrollLeft = Math.max(0, element.scrollLeft - distance);
      } else if (key === 'Home') {
        event.preventDefault();
        element.scrollLeft = 0;
      } else if (key === 'End') {
        event.preventDefault();
        element.scrollLeft = element.scrollWidth - element.clientWidth;
      }
    });
  }

  function makeUniqueSvgIds(svg: SVGSVGElement, suffix: string) {
    const elements = [svg, ...svg.querySelectorAll<SVGElement>('*')];
    const replacements = new Map<string, string>();

    for (const element of elements) {
      if (element.id) replacements.set(element.id, `${element.id}-${suffix}`);
    }

    for (const element of elements) {
      const previousId = element.id;
      if (previousId) element.id = replacements.get(previousId) ?? previousId;

      for (const attribute of element.getAttributeNames()) {
        const value = element.getAttribute(attribute);
        if (!value) continue;
        const updated = value
          .replace(/url\(#([^)]+)\)/g, (_match, id: string) => `url(#${replacements.get(id) ?? id})`)
          .replace(/#([A-Za-z_][\w:.-]*)/g, (_match, id: string) => `#${replacements.get(id) ?? id}`)
          .split(/\s+/)
          .map(token => replacements.get(token) ?? token)
          .join(' ');
        if (updated !== value) element.setAttribute(attribute, updated);
      }
    }
  }

  document.querySelectorAll<HTMLElement>('figure').forEach(figure => {
    const svg = figure.querySelector<SVGSVGElement>('svg');
    if (!svg) return;

    const trigger = document.createElement('button');
    trigger.type = 'button';
    trigger.textContent = '放大图解';
    trigger.setAttribute('aria-haspopup', 'dialog');
    trigger.addEventListener('click', () => {
      figureDialogSequence += 1;
      const suffix = `zoom-${figureDialogSequence}`;
      const dialog = document.createElement('dialog');
      dialog.className = 'figure-dialog';
      dialog.setAttribute('aria-labelledby', `${suffix}-title`);

      const title = document.createElement('h2');
      title.id = `${suffix}-title`;
      title.textContent = svg.querySelector('title')?.textContent?.trim()
        || figure.querySelector('figcaption')?.textContent?.trim()
        || '图解放大查看';

      const captionText = figure.querySelector('figcaption')?.textContent?.trim();
      const caption = captionText ? document.createElement('p') : null;
      if (caption) {
        caption.id = `${suffix}-description`;
        caption.textContent = captionText ?? '';
        dialog.setAttribute('aria-describedby', caption.id);
      }

      const close = document.createElement('button');
      close.type = 'button';
      close.textContent = '关闭';
      close.setAttribute('aria-label', '关闭放大图解');
      close.addEventListener('click', () => dialog.close());

      const enlargedSvg = svg.cloneNode(true) as SVGSVGElement;
      makeUniqueSvgIds(enlargedSvg, suffix);
      const visual = document.createElement('div');
      visual.className = 'figure-dialog-visual';
      visual.setAttribute('role', 'region');
      visual.setAttribute('aria-label', `${title.textContent}，可横向滚动查看`);
      visual.tabIndex = 0;
      enableHorizontalKeyboardScroll(visual);
      visual.append(enlargedSvg);
      dialog.append(title);
      if (caption) dialog.append(caption);
      dialog.append(close, visual);
      dialog.addEventListener('close', () => {
        dialog.remove();
        trigger.focus({preventScroll: true});
      }, {once: true});
      document.body.append(dialog);
      dialog.showModal();
      close.focus();
    });
    figure.append(trigger);
  });

  function getScrollRegionLabel(element: HTMLElement) {
    if (element.matches('.katex-display')) return '数学公式，可使用方向键横向滚动查看';
    if (element.matches('.table-scroll')) {
      const table = element.querySelector('table');
      const caption = table?.caption?.textContent?.trim();
      const headings = [...(table?.querySelectorAll('th') ?? [])].map(cell => cell.textContent?.trim()).filter(Boolean).join('、');
      return `${caption || headings || '文章数据表'}，可使用方向键横向滚动查看`;
    }
    if (element instanceof HTMLTableElement) {
      return element.caption?.textContent?.trim() || '数据表，可使用方向键横向滚动查看';
    }
    if (element instanceof HTMLPreElement) return '代码块，可使用方向键横向滚动查看';
    if (element instanceof HTMLElement && element.tagName === 'FIGURE') {
      return element.querySelector('figcaption')?.textContent?.trim() || '图表，可使用方向键横向滚动查看';
    }
    const heading = element.closest('section')?.querySelector('h2, h3')?.textContent?.trim();
    return heading ? `${heading}，可使用方向键横向滚动查看` : '内容区域，可使用方向键横向滚动查看';
  }

  function updateScrollableRegionAccessibility() {
    document.querySelectorAll<HTMLElement>('main *').forEach(element => {
      const overflowX = getComputedStyle(element).overflowX;
      const scrollable = (overflowX === 'auto' || overflowX === 'scroll')
        && element.scrollWidth > element.clientWidth + 1;

      if (!scrollable) {
        if (element.dataset.pmScrollTabindex === 'true') {
          element.removeAttribute('tabindex');
          delete element.dataset.pmScrollTabindex;
        }
        if (element.dataset.pmScrollRole === 'true') {
          element.removeAttribute('role');
          delete element.dataset.pmScrollRole;
        }
        if (element.dataset.pmScrollLabel === 'true') {
          element.removeAttribute('aria-label');
          delete element.dataset.pmScrollLabel;
        }
        return;
      }

      if (element.tabIndex < 0) {
        element.tabIndex = 0;
        element.dataset.pmScrollTabindex = 'true';
      }
      enableHorizontalKeyboardScroll(element);
      if (element.tagName === 'DIV' && !element.hasAttribute('role')) {
        element.setAttribute('role', 'region');
        element.dataset.pmScrollRole = 'true';
      }
      if (element.matches('.katex-display') && !element.hasAttribute('role')) {
        element.setAttribute('role', 'group');
        element.dataset.pmScrollRole = 'true';
      }
      if (!element.hasAttribute('aria-label') && !element.hasAttribute('aria-labelledby')) {
        element.setAttribute('aria-label', getScrollRegionLabel(element));
        element.dataset.pmScrollLabel = 'true';
      }
    });
  }

  document.querySelectorAll<HTMLTableElement>('main article.prose table').forEach(table => {
    if (table.closest('.table-scroll')) return;
    const wrapper = document.createElement('div');
    wrapper.className = 'table-scroll';
    const columnCount = table.querySelector('tr')?.children.length ?? 0;
    if (columnCount >= 4) wrapper.classList.add('table-scroll--wide');
    table.before(wrapper);
    wrapper.append(table);
  });

  updateScrollableRegionAccessibility();
  window.addEventListener('load', updateScrollableRegionAccessibility, {once: true});
  document.fonts?.ready.then(updateScrollableRegionAccessibility);
  window.addEventListener('resize', updateScrollableRegionAccessibility, {passive: true});

  document.querySelectorAll('pre').forEach(pre=>{const toolbar=document.createElement('div');toolbar.className='code-toolbar';const label=document.createElement('span');label.textContent=pre.querySelector('code')?.className.match(/language-([\w-]+)/)?.[1]?.toUpperCase()??'代码';const button=document.createElement('button');button.textContent='复制代码';button.addEventListener('click',async()=>{try{await navigator.clipboard.writeText(pre.querySelector('code')?.textContent??'');button.textContent='已复制'}catch{button.textContent='复制失败，请手动选择'}});toolbar.append(label,button);pre.before(toolbar)});
</script>
