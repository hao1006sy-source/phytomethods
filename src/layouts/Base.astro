---
const { title = 'PhytoMethods' } = Astro.props;
const base = import.meta.env.BASE_URL;
import 'katex/dist/katex.min.css';
---
<!doctype html><html lang="zh-CN"><head><meta charset="utf-8"/><meta name="viewport" content="width=device-width"/><meta name="description" content="植物基因组学与生物信息学方法知识库"/><title>{title} | PhytoMethods</title></head><body><header><div class="wrap"><a href={base} class="brand">PhytoMethods</a><span>植物基因组学与生物信息学方法知识库</span><nav><a href={base}>首页</a><a href={`${base}topics/`}>研究领域</a><a href={`${base}methods/`}>算法与工具</a><a href={`${base}papers/`}>文献索引</a><a href={`${base}tutorials/`}>分析教程</a><a href={`${base}search/`}>搜索</a><a href={`${base}about/`}>关于</a></nav></div></header><main class="wrap" data-pagefind-body><slot /></main><footer class="wrap">PhytoMethods · 植物基因组学与生物信息学方法知识库 · <a href="https://github.com/hao1006sy-source/phytomethods">GitHub</a></footer></body></html>
<style is:global> *{box-sizing:border-box} body{margin:0;color:#253b48;background:#f3f6f8;font-family:system-ui,'Microsoft YaHei',sans-serif;line-height:1.7} .wrap{max-width:1200px;margin:auto;padding:24px} header{background:#153b54;color:white} header .wrap{display:flex;align-items:center;gap:24px;flex-wrap:wrap} header a{color:white} .brand{font-size:1.5rem;font-weight:700} nav{margin-left:auto;display:flex;flex-wrap:wrap;gap:20px} a{color:#216b62} .grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:16px}.card{background:white;padding:24px;border:1px solid #dce5e8;border-radius:8px;overflow-wrap:anywhere}.card h2{font-size:1.2rem;margin:.2em 0}.id{color:#347b70;font-weight:700} h1{color:#153b54} footer{border-top:1px solid #dce5e8;margin-top:50px!important} pre{overflow:auto;padding:1rem;border-radius:6px} :focus-visible{outline:3px solid #df9c21;outline-offset:3px} [hidden]{display:none!important} @media(max-width:700px){.grid{grid-template-columns:1fr}nav{margin-left:0;width:100%}}</style>
<script>
  document.querySelectorAll<HTMLElement>('figure').forEach(figure => {
    const svg = figure.querySelector('svg');
    if (!svg) return;
    const button = document.createElement('button');
    button.type = 'button'; button.textContent = '放大图解';
    button.addEventListener('click', () => {
      const dialog = document.createElement('dialog');
      dialog.className = 'figure-dialog';
      const close = document.createElement('button'); close.textContent = '关闭';
      close.addEventListener('click', () => dialog.close());
      dialog.addEventListener('close', () => dialog.remove());
      dialog.append(close, svg.cloneNode(true)); document.body.append(dialog); dialog.showModal();
    });
    figure.append(button);
  });
  document.querySelectorAll('pre').forEach(pre => {
    const button = document.createElement('button');
    button.textContent = '复制代码';
    button.addEventListener('click', async () => {
      try { await navigator.clipboard.writeText(pre.querySelector('code')?.textContent ?? ''); button.textContent = '已复制'; }
      catch { button.textContent = '复制失败，请手动选择'; }
    });
    pre.before(button);
  });
</script>
<style is:global>.figure-dialog{width:min(95vw,1000px);max-height:90vh;border:1px solid #a9c7c4;border-radius:8px;overflow:auto}.figure-dialog::backdrop{background:#153b54aa}.figure-dialog svg{display:block;width:100%;min-width:650px;margin-top:1rem}.filters{display:flex;gap:12px;flex-wrap:wrap;align-items:end;margin:1.5rem 0}.filters label{display:grid;gap:.25rem}.filters input,.filters select,.filters button,button{font:inherit;padding:.45rem .65rem;border:1px solid #a9bbc4;border-radius:4px;background:white;color:#153b54;cursor:pointer}.filters input{cursor:text}</style>
